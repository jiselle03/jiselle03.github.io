---
import '../../styles/launchline.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Cadence is a fictional frontend-only operations dashboard concept by Jiselle Liu." />
    <meta name="theme-color" content="#10233f" />
    <title>Cadence | Independent Product Demo</title>
  </head>
  <body class="launchline-body">
    <a class="ll-skip" href="#launch-portfolio">Skip to launch portfolio</a>
    <main class="ll-app">
      <aside class="ll-sidebar" aria-label="Cadence navigation">
        <a class="ll-brand" href="/demo/launchline/"><span aria-hidden="true">C</span> Cadence</a>
        <p class="ll-workspace">Regional operations</p>
        <nav class="ll-nav" aria-label="Product sections">
          <a href="#overview" aria-current="page">Program</a>
          <a href="#launch-portfolio">Locations</a>
          <a href="#role-inbox">Inbox</a>
        </nav>
        <div class="ll-sidebar-note"><span>Fictional demo</span><p>Independent, frontend-only product concept. No client data or backend.</p></div>
      </aside>

      <section class="ll-content">
        <header class="ll-topbar">
          <div><p>Q3 opening program / Northeast</p><h1>Opening program</h1></div>
          <div><a class="ll-back-link" href="/">Back to portfolio</a></div>
        </header>

        <section id="overview" class="ll-intro" aria-labelledby="intro-title">
          <div><p class="ll-label">The situation</p><h2 id="intro-title">See what could move the opening date before it does.</h2></div>
          <p>A regional manager keeps facilities, training, finance, and operations in the same plan. This demo uses fictional data.</p>
        </section>

        <section class="ll-scenario" aria-label="Operating scenario">
          <div><p class="ll-label">This week</p><strong>Five locations open in the next six weeks.</strong><span>Harbor Point's delivery window overlaps staff training.</span><button id="show-tour" class="ll-scenario-action" type="button">Walk through the conflict</button></div>
          <dl><div><dt>What goes wrong</dt><dd>Changes get buried in calendars, spreadsheets, and inboxes.</dd></div><div><dt>What changes here</dt><dd>The blocker, owner, schedule, and decision stay on one record.</dd></div></dl>
        </section>

        <section class="ll-metrics" aria-label="Launch metrics">
          <article><p>On track</p><strong id="on-track-count">3</strong><span>of 5 planned openings</span></article>
          <article><p>Needs attention</p><strong id="attention-count">2</strong><span>one decision due today</span></article>
          <article><p>Tasks complete</p><strong id="task-rate">76%</strong><span>across active launch plans</span></article>
          <article><p>Approval coverage</p><strong id="approval-rate">60%</strong><span>locations with a recorded decision</span></article>
        </section>

        <section class="ll-insights" aria-label="Program insights">
          <article class="ll-chart"><div class="ll-panel-heading"><div><p class="ll-label">Readiness trend</p><h2>Readiness this month</h2></div><span>6 weeks</span></div><div class="ll-bars" aria-label="Readiness trend from 48 to 76 percent"><div class="is-risk"><i style="height:48%"></i><small>W1</small></div><div class="is-risk"><i style="height:56%"></i><small>W2</small></div><div><i style="height:61%"></i><small>W3</small></div><div><i style="height:66%"></i><small>W4</small></div><div class="is-ready"><i style="height:72%"></i><small>W5</small></div><div class="is-current"><i style="height:76%"></i><small>Now</small></div></div></article>
          <article class="ll-decision"><p class="ll-label">Next decision</p><h2>Harbor Point has a delivery conflict.</h2><p>Review the impacted training session and assign the mitigation owner before Thursday.</p><button id="open-harbor" type="button">Open Harbor Point</button></article>
          <article class="ll-function-health"><p class="ll-label">By function</p><h2>Where the plan is thin</h2><dl><div><dt>Facilities</dt><dd><span><i style="width:58%"></i></span>58%</dd></div><div><dt>Training</dt><dd><span><i style="width:66%"></i></span>66%</dd></div><div><dt>Finance</dt><dd><span><i style="width:92%"></i></span>92%</dd></div><div><dt>Operations</dt><dd><span><i style="width:88%"></i></span>88%</dd></div></dl></article>
        </section>

        <section id="launch-portfolio" class="ll-portfolio" aria-labelledby="portfolio-title">
          <div class="ll-portfolio-head"><div><p class="ll-label">Active program</p><h2 id="portfolio-title">Launch portfolio</h2></div><div class="ll-filter-row" aria-label="Saved portfolio views"><button class="ll-filter is-active" data-view="all" type="button" aria-pressed="true">All launches</button><button class="ll-filter" data-view="attention" type="button" aria-pressed="false">Needs attention</button><button class="ll-filter" data-view="mine" type="button" aria-pressed="false">My work</button><button class="ll-filter" data-view="approved" type="button" aria-pressed="false">Approved</button></div></div>
          <div class="ll-advanced-filters"><label>Region<select id="region-filter"><option value="all">All regions</option><option value="northeast">Northeast</option><option value="midatlantic">Mid-Atlantic</option></select></label><label>Opening month<select id="month-filter"><option value="all">All months</option><option value="sep">September</option><option value="oct">October</option></select></label><button id="clear-filters" type="button">Clear filters</button></div>
          <div class="ll-table-wrap"><table><thead><tr><th>Location</th><th>Opening</th><th>Readiness</th><th>Current blocker</th><th>Owner</th><th>Decision</th></tr></thead><tbody id="launch-rows"></tbody></table><div id="empty-portfolio" class="ll-empty" hidden><strong>No launches match these filters.</strong><button id="empty-clear" type="button">Clear filters</button></div></div>
        </section>

        <section id="selected-launch" class="ll-selection" aria-labelledby="selected-name">
          <div id="out-of-view" class="ll-out-of-view" hidden><span>This location is outside the current portfolio view.</span><button id="return-portfolio" type="button">Return to portfolio</button></div>
          <div class="ll-selection-header"><div><p id="selected-region" class="ll-label"></p><h2 id="selected-name">Harbor Point</h2><p id="selected-summary"></p></div><div><span id="selected-status" class="ll-status"></span><strong id="selected-score">0%</strong><small>readiness</small></div></div>
          <div class="ll-preview-grid"><article><p class="ll-label">Opening target</p><strong id="selected-date"></strong><span id="selected-owner"></span></article><article><p class="ll-label">Current blocker</p><strong id="selected-blocker"></strong><span>Open the workspace to change the plan.</span></article><article><p class="ll-label">Decision state</p><strong id="selected-decision"></strong><span id="decision-note">The approval record shows the current risk and owner.</span></article></div>
        </section>

        <section class="ll-workspace" aria-labelledby="workspace-title">
          <div class="ll-workspace-title"><div><p class="ll-label">Location workspace</p><h2 id="workspace-title">The work behind the opening date.</h2></div><span>Shared record / fictional data</span></div>
          <div class="ll-tabs" role="tablist" aria-label="Location workspace views"><button role="tab" aria-selected="true" aria-controls="panel-plan" id="tab-plan" data-tab="plan">Plan</button><button role="tab" aria-selected="false" aria-controls="panel-schedule" id="tab-schedule" data-tab="schedule">Schedule</button><button role="tab" aria-selected="false" aria-controls="panel-dependencies" id="tab-dependencies" data-tab="dependencies">Dependencies</button><button role="tab" aria-selected="false" aria-controls="panel-team" id="tab-team" data-tab="team">Team</button><button role="tab" aria-selected="false" aria-controls="panel-approvals" id="tab-approvals" data-tab="approvals">Approvals</button><button role="tab" aria-selected="false" aria-controls="panel-activity" id="tab-activity" data-tab="activity">Activity</button></div>
          <div id="panel-plan" class="ll-tab-panel" role="tabpanel" aria-labelledby="tab-plan"><div class="ll-panel-copy"><div><p class="ll-label">Readiness plan</p><h3>Work that determines the opening date</h3></div><span id="plan-progress">0 of 0 complete</span></div><div id="task-list" class="ll-task-list"></div></div>
          <div id="panel-schedule" class="ll-tab-panel" role="tabpanel" aria-labelledby="tab-schedule" hidden><div class="ll-panel-copy"><div><p class="ll-label">Launch week</p><h3>One schedule, connected to the plan</h3></div><span id="schedule-note">No conflicts</span></div><div id="schedule-grid" class="ll-schedule-grid"></div></div>
          <div id="panel-dependencies" class="ll-tab-panel" role="tabpanel" aria-labelledby="tab-dependencies" hidden><div class="ll-panel-copy"><div><p class="ll-label">Dependency map</p><h3>See what moves when one prerequisite slips.</h3></div><span id="dependency-count"></span></div><div id="dependency-list" class="ll-dependency-list"></div></div>
          <div id="panel-team" class="ll-tab-panel" role="tabpanel" aria-labelledby="tab-team" hidden><div class="ll-panel-copy"><div><p class="ll-label">Launch team</p><h3>Roles, availability, and the next handoff</h3></div></div><div id="team-list" class="ll-team-list"></div></div>
          <div id="panel-approvals" class="ll-tab-panel" role="tabpanel" aria-labelledby="tab-approvals" hidden><div class="ll-approval-sheet"><div><p class="ll-label">Opening decision sheet</p><h3 id="approval-title">Approval unavailable</h3><p id="approval-copy"></p></div><dl><div><dt>Opening target</dt><dd id="approval-date"></dd></div><div><dt>Approver</dt><dd>Maya Chen</dd></div><div><dt>Remaining risk</dt><dd id="approval-risk"></dd></div></dl><div class="ll-approval-actions"><button id="open-exception" type="button">Record exception</button><button id="approve-launch" type="button">Approve opening</button></div></div></div>
          <div id="panel-activity" class="ll-tab-panel" role="tabpanel" aria-labelledby="tab-activity" hidden><div class="ll-panel-copy"><div><p class="ll-label">Operational record</p><h3>Why the plan changed</h3></div></div><ol id="activity-list" class="ll-activity-list"></ol></div>
        </section>

        <section id="role-inbox" class="ll-inbox" aria-labelledby="inbox-title"><div class="ll-inbox-head"><div><p class="ll-label">Role inbox</p><h2 id="inbox-title">Each team sees the work it owns.</h2></div><label>View as <select id="role-select"><option value="manager">Launch manager</option><option value="facilities">Facilities</option><option value="operations">Operations</option><option value="training">Training</option><option value="finance">Finance</option></select></label></div><div id="inbox-list" class="ll-inbox-list"></div></section>

        <footer>Fictional frontend demo by <a href="/">Jiselle Liu</a>.</footer>
      </section>
    </main>

    <dialog id="assignment-dialog" class="ll-dialog" aria-labelledby="assignment-title"><form method="dialog"><p class="ll-label">Task assignment</p><h2 id="assignment-title">Assign the next owner</h2><p id="assignment-task"></p><label>Owner<select id="assignment-owner"><option>Maya Chen</option><option>Noah Williams</option><option>Ava Singh</option><option>Rina Shah</option></select></label><label>Due date<input id="assignment-date" type="date" value="2026-09-18" /></label><div><button value="cancel" type="submit" class="ll-dialog-cancel">Cancel</button><button id="save-assignment" value="default" type="submit">Save assignment</button></div></form></dialog>
    <dialog id="schedule-dialog" class="ll-dialog" aria-labelledby="schedule-title"><form method="dialog"><p class="ll-label">Schedule adjustment</p><h2 id="schedule-title">Move staff training</h2><p>The delivery window overlaps this session. Choose a new window to remove the conflict.</p><label>New training window<select id="new-training-time"><option value="09:00">9:00 AM - 11:00 AM</option><option value="14:00">2:00 PM - 4:00 PM</option></select></label><div><button value="cancel" type="submit" class="ll-dialog-cancel">Cancel</button><button id="save-schedule" value="default" type="submit">Save schedule</button></div></form></dialog>
    <dialog id="exception-dialog" class="ll-dialog" aria-labelledby="exception-title"><form method="dialog"><p class="ll-label">Launch exception</p><h2 id="exception-title">Record a managed decision</h2><p id="exception-summary">Document the owner, mitigation, and approval condition before the location can move forward.</p><div class="ll-form-grid"><label>Severity<select id="exception-severity"><option value="high">High</option><option value="medium">Medium</option><option value="low">Low</option></select></label><label>Accountable owner<select id="exception-owner"><option value="">Choose an owner</option><option>Maya Chen</option><option>Ava Singh</option><option>Rina Shah</option></select></label></div><label>Mitigation<textarea id="exception-mitigation" rows="3" placeholder="Describe the recovery plan"></textarea></label><div class="ll-impact-preview"><p class="ll-label">Impact preview</p><ul id="impact-list"></ul></div><p id="exception-error" class="ll-form-error" hidden></p><div><button value="cancel" type="submit" class="ll-dialog-cancel">Cancel</button><button id="resolve-exception" value="default" type="submit">Resolve and approve</button><button id="accept-risk" value="default" type="submit">Accept risk</button></div></form></dialog>
    <dialog id="tour-dialog" class="ll-dialog ll-tour-dialog" aria-labelledby="tour-title"><div><p id="tour-step" class="ll-label">Guided scenario</p><h2 id="tour-title">Resolve one launch conflict.</h2><p id="tour-copy">Cadence will take you from a schedule conflict to a recorded decision. You can dismiss at any point.</p><div><button id="tour-dismiss" class="ll-dialog-cancel" type="button">Dismiss</button><button id="tour-start" type="button">Start scenario</button></div></div></dialog>
    <aside id="tour-popover" class="ll-tour-popover" aria-live="polite" hidden><p id="tour-popover-step" class="ll-label"></p><strong id="tour-popover-title"></strong><p id="tour-popover-copy"></p><button id="tour-popover-dismiss" type="button">Dismiss</button></aside>

    <script>
      type Launch = { id: number; name: string; region: 'northeast' | 'midatlantic'; regionLabel: string; month: 'sep' | 'oct'; date: string; readiness: number; blocker: string; owner: string; status: 'On track' | 'Needs attention' | 'Approved'; decision: string; summary: string; mine: boolean; };
      const launches: Launch[] = [
        { id: 1, name: 'Harbor Point', region: 'northeast', regionLabel: 'Northeast / Boston', month: 'sep', date: 'Sep 26', readiness: 62, blocker: 'Delivery overlaps training', owner: 'Maya Chen', status: 'Needs attention', decision: 'Decision required', summary: 'New waterfront location with a compressed equipment and training window.', mine: true },
        { id: 2, name: 'West Elm Street', region: 'northeast', regionLabel: 'Northeast / Providence', month: 'sep', date: 'Sep 30', readiness: 78, blocker: 'No active blockers', owner: 'Noah Williams', status: 'On track', decision: 'In review', summary: 'Standard opening plan with facilities inspection booked.', mine: false },
        { id: 3, name: 'Mason Square', region: 'midatlantic', regionLabel: 'Mid-Atlantic / Philadelphia', month: 'oct', date: 'Oct 08', readiness: 91, blocker: 'No active blockers', owner: 'Maya Chen', status: 'Approved', decision: 'Approved', summary: 'Opening plan approved after final compliance review.', mine: true },
        { id: 4, name: 'Cedar Crossing', region: 'midatlantic', regionLabel: 'Mid-Atlantic / Baltimore', month: 'oct', date: 'Oct 14', readiness: 69, blocker: 'Site inspection pending', owner: 'Ava Singh', status: 'Needs attention', decision: 'Awaiting evidence', summary: 'Inspection evidence is due before the operations handoff.', mine: false },
        { id: 5, name: 'Eastford Market', region: 'northeast', regionLabel: 'Northeast / Hartford', month: 'oct', date: 'Oct 22', readiness: 83, blocker: 'No active blockers', owner: 'Noah Williams', status: 'On track', decision: 'In review', summary: 'Team assignments complete; training materials are confirmed.', mine: false },
      ];
      type Task = { id: string; title: string; function: string; owner: string; due: string; complete: boolean; blocked?: boolean };
      type ScheduleEvent = { title: string; time: string; function: string; conflict?: boolean };
      type TeamMember = { role: string; name: string; availability: string; next: string };
      const tasksByLaunch: Record<number, Task[]> = {
        1: [{ id: 'delivery', title: 'Confirm equipment delivery window', function: 'Facilities', owner: 'Ava Singh', due: 'Sep 17', complete: false, blocked: true }, { id: 'training', title: 'Run opening team training', function: 'Training', owner: 'Unassigned', due: 'Sep 18', complete: false, blocked: true }, { id: 'finance', title: 'Release opening budget', function: 'Finance', owner: 'Noah Williams', due: 'Sep 15', complete: true }, { id: 'inspection', title: 'Complete site safety inspection', function: 'Operations', owner: 'Rina Shah', due: 'Sep 20', complete: true }],
        2: [{ id: 'inspect', title: 'Complete facilities inspection', function: 'Facilities', owner: 'Ava Singh', due: 'Sep 22', complete: false }, { id: 'staff', title: 'Confirm opening team roster', function: 'Operations', owner: 'Rina Shah', due: 'Sep 21', complete: true }],
        3: [{ id: 'signoff', title: 'Archive final launch sign-off', function: 'Launch manager', owner: 'Maya Chen', due: 'Oct 03', complete: true }],
        4: [{ id: 'evidence', title: 'Upload inspection evidence', function: 'Facilities', owner: 'Ava Singh', due: 'Oct 02', complete: false, blocked: true }],
        5: [{ id: 'materials', title: 'Deliver training materials', function: 'Training', owner: 'Rina Shah', due: 'Oct 13', complete: true }],
      };
      const eventsByLaunch: Record<number, ScheduleEvent[]> = { 1: [{ title: 'Equipment delivery', time: '10:00 AM - 2:00 PM', function: 'Facilities', conflict: true }, { title: 'Opening team training', time: '10:30 AM - 12:30 PM', function: 'Training', conflict: true }, { title: 'Safety inspection', time: '3:00 PM - 4:00 PM', function: 'Operations' }, { title: 'Opening day', time: '9:00 AM', function: 'Launch' }], 2: [{ title: 'Facilities inspection', time: '10:00 AM', function: 'Facilities' }, { title: 'Team roster review', time: '2:00 PM', function: 'Operations' }], 3: [{ title: 'Opening day', time: '9:00 AM', function: 'Launch' }], 4: [{ title: 'Site inspection', time: '11:00 AM', function: 'Facilities', conflict: true }], 5: [{ title: 'Training delivery', time: '1:00 PM', function: 'Training' }] };
      const teamByLaunch: Record<number, TeamMember[]> = { 1: [{ role: 'Launch manager', name: 'Maya Chen', availability: 'Available today', next: 'Record decision' }, { role: 'Facilities', name: 'Ava Singh', availability: 'At site Tue', next: 'Confirm delivery window' }, { role: 'Training', name: 'Rina Shah', availability: 'Available Thu', next: 'Accept training handoff' }, { role: 'Finance', name: 'Noah Williams', availability: 'Complete', next: 'No action' }], 2: [{ role: 'Launch manager', name: 'Noah Williams', availability: 'Available', next: 'Review inspection' }], 3: [{ role: 'Launch manager', name: 'Maya Chen', availability: 'Complete', next: 'No action' }], 4: [{ role: 'Facilities', name: 'Ava Singh', availability: 'Available', next: 'Upload evidence' }], 5: [{ role: 'Training', name: 'Rina Shah', availability: 'Available', next: 'No action' }] };
      const activityByLaunch: Record<number, string[]> = { 1: ['Finance released the opening budget', 'Facilities reported a delivery window conflict', 'Maya Chen opened a launch exception'], 2: ['Operations confirmed the opening roster', 'Inspection added to launch plan'], 3: ['Maya Chen recorded final approval'], 4: ['Facilities requested inspection evidence'], 5: ['Training materials confirmed'] };
      type ExceptionState = { status: 'open' | 'resolved' | 'accepted'; owner?: string; mitigation?: string; severity: string };
      const exceptions: Record<number, ExceptionState> = { 1: { status: 'open', severity: 'high' }, 4: { status: 'open', severity: 'medium' } };
      let selectedId = 1; let view = 'all'; let region = 'all'; let month = 'all';
      const get = <T extends HTMLElement>(selector: string) => { const element = document.querySelector<T>(selector); if (!element) throw new Error(`Missing ${selector}`); return element; };
      const rows = get<HTMLTableSectionElement>('#launch-rows'); const regionFilter = get<HTMLSelectElement>('#region-filter'); const monthFilter = get<HTMLSelectElement>('#month-filter'); const empty = get<HTMLDivElement>('#empty-portfolio'); const outOfView = get<HTMLDivElement>('#out-of-view');
      const selected = () => launches.find((launch) => launch.id === selectedId)!;
      const visible = () => launches.filter((launch) => (view === 'all' || (view === 'attention' && launch.status === 'Needs attention') || (view === 'mine' && launch.mine) || (view === 'approved' && launch.status === 'Approved')) && (region === 'all' || launch.region === region) && (month === 'all' || launch.month === month));
      const resetFilters = () => { view = 'all'; region = 'all'; month = 'all'; regionFilter.value = 'all'; monthFilter.value = 'all'; document.querySelectorAll<HTMLButtonElement>('.ll-filter').forEach((button) => { const active = button.dataset.view === 'all'; button.classList.toggle('is-active', active); button.setAttribute('aria-pressed', String(active)); }); render(); };
      const renderMetrics = () => { get('#on-track-count').textContent = String(launches.filter((launch) => launch.status === 'On track').length); get('#attention-count').textContent = String(launches.filter((launch) => launch.status === 'Needs attention').length); get('#task-rate').textContent = `${Math.round(launches.reduce((total, launch) => total + launch.readiness, 0) / launches.length)}%`; get('#approval-rate').textContent = `${Math.round((launches.filter((launch) => launch.status === 'Approved').length / launches.length) * 100)}%`; };
      const renderRows = () => { const available = visible(); rows.replaceChildren(); empty.hidden = available.length > 0; available.forEach((launch) => { const row = document.createElement('tr'); row.className = launch.id === selectedId ? 'is-selected' : ''; const location = document.createElement('td'); const choose = document.createElement('button'); choose.type = 'button'; choose.className = 'll-row-select'; choose.innerHTML = `<strong>${launch.name}</strong><span>${launch.regionLabel}</span>`; choose.addEventListener('click', () => { selectedId = launch.id; render(); document.querySelector('#selected-launch')?.scrollIntoView({ behavior: 'smooth', block: 'start' }); }); location.append(choose); const opening = document.createElement('td'); opening.textContent = launch.date; const readiness = document.createElement('td'); readiness.innerHTML = `<b>${launch.readiness}%</b><i><em style="width:${launch.readiness}%"></em></i>`; const blocker = document.createElement('td'); blocker.textContent = launch.blocker; const owner = document.createElement('td'); owner.textContent = launch.owner; const decision = document.createElement('td'); decision.innerHTML = `<mark class="${launch.status.toLowerCase().replaceAll(' ', '-')}">${launch.decision}</mark>`; row.append(location, opening, readiness, blocker, owner, decision); rows.append(row); }); };
      const renderSelection = () => { const launch = selected(); get('#selected-region').textContent = launch.regionLabel; get('#selected-name').textContent = launch.name; get('#selected-summary').textContent = launch.summary; get('#selected-status').textContent = launch.status; get('#selected-status').className = `ll-status ${launch.status.toLowerCase().replaceAll(' ', '-')}`; get('#selected-score').textContent = `${launch.readiness}%`; get('#selected-date').textContent = launch.date; get('#selected-owner').textContent = `Launch owner: ${launch.owner}`; get('#selected-blocker').textContent = launch.blocker; get('#selected-decision').textContent = launch.decision; get('#decision-note').textContent = launch.status === 'Approved' ? 'The approval and its conditions are recorded below.' : launch.status === 'Needs attention' ? 'A decision is waiting on the current blocker.' : 'The owner is collecting the remaining sign-off.'; outOfView.hidden = visible().some((item) => item.id === launch.id); };
      const getTasks = () => tasksByLaunch[selectedId] || []; const getEvents = () => eventsByLaunch[selectedId] || []; const getActivity = () => activityByLaunch[selectedId] || [];
      const taskList = get<HTMLDivElement>('#task-list'); const scheduleGrid = get<HTMLDivElement>('#schedule-grid'); const dependencyList = get<HTMLDivElement>('#dependency-list'); const teamList = get<HTMLDivElement>('#team-list'); const activityList = get<HTMLOListElement>('#activity-list'); const assignmentDialog = get<HTMLDialogElement>('#assignment-dialog'); const scheduleDialog = get<HTMLDialogElement>('#schedule-dialog'); const exceptionDialog = get<HTMLDialogElement>('#exception-dialog'); const tourDialog = get<HTMLDialogElement>('#tour-dialog'); const tourPopover = get<HTMLElement>('#tour-popover'); let assignmentTaskId = ''; let tourActive = false; let tourStep = 0; let tourTarget: HTMLElement | null = null;
      const renderWorkspace = () => { const launch = selected(); const tasks = getTasks(); const completed = tasks.filter((task) => task.complete).length; get('#plan-progress').textContent = `${completed} of ${tasks.length} complete`; taskList.replaceChildren(); tasks.forEach((task) => { const item = document.createElement('article'); item.className = `ll-task${task.complete ? ' is-complete' : ''}${task.blocked ? ' is-blocked' : ''}`; const copy = document.createElement('div'); copy.innerHTML = `<span>${task.function} / Due ${task.due}</span><strong>${task.title}</strong><small>${task.owner}</small>`; const action = document.createElement('button'); action.type = 'button'; action.textContent = task.complete ? 'Complete' : task.owner === 'Unassigned' ? 'Assign owner' : 'Reassign'; action.disabled = task.complete; action.addEventListener('click', () => { assignmentTaskId = task.id; get('#assignment-task').textContent = task.title; get<HTMLSelectElement>('#assignment-owner').value = task.owner === 'Unassigned' ? 'Rina Shah' : task.owner; assignmentDialog.showModal(); }); item.append(copy, action); taskList.append(item); });
        scheduleGrid.replaceChildren(); const conflicted = getEvents().some((event) => event.conflict); get('#schedule-note').textContent = conflicted ? '1 timing conflict' : 'No conflicts'; getEvents().forEach((event) => { const item = document.createElement('article'); item.className = `ll-schedule-event${event.conflict ? ' is-conflict' : ''}`; item.innerHTML = `<span>${event.function}</span><strong>${event.title}</strong><small>${event.time}</small>`; if (event.conflict) { const action = document.createElement('button'); action.type = 'button'; action.textContent = 'Adjust'; if (event.title === 'Opening team training') action.id = 'adjust-training'; action.addEventListener('click', () => { stopTourGuide(); scheduleDialog.showModal(); }); item.append(action); } scheduleGrid.append(item); });
        const blocking = tasks.filter((task) => task.blocked || !task.complete); get('#dependency-count').textContent = `${blocking.length} active dependency${blocking.length === 1 ? '' : 'ies'}`; dependencyList.replaceChildren(); blocking.forEach((task, index) => { const item = document.createElement('article'); item.innerHTML = `<span>0${index + 1}</span><div><strong>${task.title}</strong><p>${task.blocked ? 'This task is blocking a downstream launch handoff.' : 'This task must close before approval.'}</p></div><b>${task.owner}</b>`; dependencyList.append(item); });
        teamList.replaceChildren(); (teamByLaunch[selectedId] || []).forEach((member) => { const item = document.createElement('article'); item.innerHTML = `<div><span>${member.role}</span><strong>${member.name}</strong></div><div><span>${member.availability}</span><strong>${member.next}</strong></div>`; teamList.append(item); });
        const unresolved = tasks.some((task) => !task.complete); const exception = exceptions[selectedId]; const acceptedRisk = exception?.status === 'accepted'; const resolved = exception?.status === 'resolved'; get('#approval-date').textContent = launch.date; get('#approval-risk').textContent = acceptedRisk ? 'Accepted with condition' : unresolved ? launch.blocker : 'No active risk'; get('#approval-title').textContent = acceptedRisk ? 'Approved with risk' : resolved || !unresolved ? 'Ready for approval' : 'Approval unavailable'; get('#approval-copy').textContent = acceptedRisk ? `Conditional approval recorded. ${exception?.owner} owns: ${exception?.mitigation}` : unresolved ? 'The opening cannot be approved while the active dependency remains unresolved. Resolve it or record a managed-risk decision.' : 'All readiness work is complete and the opening has a clear audit trail.'; const approvalButton = get<HTMLButtonElement>('#approve-launch'); approvalButton.disabled = unresolved && !acceptedRisk; approvalButton.textContent = acceptedRisk ? 'Conditional approval recorded' : unresolved ? 'Resolve blocker first' : 'Approve opening'; get<HTMLButtonElement>('#open-exception').textContent = acceptedRisk || resolved ? 'View exception' : 'Record exception';
        activityList.replaceChildren(); getActivity().slice().reverse().forEach((entry) => { const item = document.createElement('li'); item.textContent = entry; activityList.append(item); }); };
      const renderInbox = () => { const role = get<HTMLSelectElement>('#role-select').value; const inbox = get<HTMLDivElement>('#inbox-list'); inbox.replaceChildren(); launches.flatMap((launch) => (tasksByLaunch[launch.id] || []).filter((task) => !task.complete && (role === 'manager' || task.function.toLowerCase().replaceAll(' ', '') === role)).map((task) => ({ launch, task }))).forEach(({ launch, task }) => { const item = document.createElement('button'); item.type = 'button'; item.className = 'll-inbox-item'; item.innerHTML = `<span>${task.function} / ${launch.date}</span><strong>${task.title}</strong><small>${launch.name} · ${task.owner}</small>`; item.addEventListener('click', () => { selectedId = launch.id; render(); document.querySelector<HTMLButtonElement>('[data-tab="plan"]')?.click(); get('#selected-launch').scrollIntoView({ behavior: 'smooth', block: 'start' }); }); inbox.append(item); }); if (!inbox.childElementCount) inbox.innerHTML = '<p class="ll-inbox-empty">No outstanding work for this role.</p>'; };
      const render = () => { renderMetrics(); renderRows(); renderSelection(); renderWorkspace(); renderInbox(); };
      const showTab = (tab: string) => document.querySelector<HTMLButtonElement>(`[data-tab="${tab}"]`)?.click();
      const positionTour = () => { if (!tourTarget || tourPopover.hidden) return; const rect = tourTarget.getBoundingClientRect(); const width = tourPopover.offsetWidth; const height = tourPopover.offsetHeight; tourPopover.style.left = `${Math.max(16, Math.min(window.innerWidth - width - 16, rect.left))}px`; tourPopover.style.top = `${Math.max(16, Math.min(window.innerHeight - height - 16, rect.bottom + 14))}px`; };
      const stopTourGuide = () => { tourTarget?.classList.remove('ll-tour-target'); tourTarget = null; tourPopover.hidden = true; };
      const stopTour = () => { tourActive = false; stopTourGuide(); };
      const showGuide = (target: HTMLElement, step: string, title: string, copy: string) => { stopTourGuide(); tourTarget = target; target.classList.add('ll-tour-target'); get('#tour-popover-step').textContent = step; get('#tour-popover-title').textContent = title; get('#tour-popover-copy').textContent = copy; tourPopover.hidden = false; target.scrollIntoView({ behavior: 'smooth', block: 'center' }); window.setTimeout(positionTour, 350); };
      const resetScenario = () => { const harbor = launches[0]; harbor.status = 'Needs attention'; harbor.decision = 'Decision required'; harbor.readiness = 62; harbor.blocker = 'Delivery overlaps training'; tasksByLaunch[1] = [{ id: 'delivery', title: 'Confirm equipment delivery window', function: 'Facilities', owner: 'Ava Singh', due: 'Sep 17', complete: false, blocked: true }, { id: 'training', title: 'Run opening team training', function: 'Training', owner: 'Unassigned', due: 'Sep 18', complete: false, blocked: true }, { id: 'finance', title: 'Release opening budget', function: 'Finance', owner: 'Noah Williams', due: 'Sep 15', complete: true }, { id: 'inspection', title: 'Complete site safety inspection', function: 'Operations', owner: 'Rina Shah', due: 'Sep 20', complete: true }]; eventsByLaunch[1] = [{ title: 'Equipment delivery', time: '10:00 AM - 2:00 PM', function: 'Facilities', conflict: true }, { title: 'Opening team training', time: '10:30 AM - 12:30 PM', function: 'Training', conflict: true }, { title: 'Safety inspection', time: '3:00 PM - 4:00 PM', function: 'Operations' }, { title: 'Opening day', time: '9:00 AM', function: 'Launch' }]; exceptions[1] = { status: 'open', severity: 'high' }; activityByLaunch[1] = ['Finance released the opening budget', 'Facilities reported a delivery window conflict', 'Maya Chen opened a launch exception']; };
      const beginTour = () => { resetScenario(); selectedId = 1; view = 'attention'; document.querySelectorAll<HTMLButtonElement>('.ll-filter').forEach((button) => { const active = button.dataset.view === 'attention'; button.classList.toggle('is-active', active); button.setAttribute('aria-pressed', String(active)); }); render(); tourActive = true; tourStep = 1; tourDialog.close(); showTab('schedule'); window.setTimeout(() => { const adjust = get<HTMLButtonElement>('#adjust-training'); showGuide(adjust, 'Step 1 of 3', 'Move the conflicting training session', 'The equipment delivery overlaps training. Select Adjust to choose a safe window.'); }, 250); };
      document.querySelectorAll<HTMLButtonElement>('.ll-filter').forEach((button) => button.addEventListener('click', () => { view = button.dataset.view || 'all'; document.querySelectorAll<HTMLButtonElement>('.ll-filter').forEach((item) => { const active = item === button; item.classList.toggle('is-active', active); item.setAttribute('aria-pressed', String(active)); }); const first = visible()[0]; if (first) selectedId = first.id; render(); }));
      regionFilter.addEventListener('change', () => { region = regionFilter.value; render(); }); monthFilter.addEventListener('change', () => { month = monthFilter.value; render(); }); get('#clear-filters').addEventListener('click', resetFilters); get('#empty-clear').addEventListener('click', resetFilters); get('#return-portfolio').addEventListener('click', () => { resetFilters(); get('#launch-portfolio').scrollIntoView({ behavior: 'smooth', block: 'start' }); });
      get('#open-harbor').addEventListener('click', () => { selectedId = 1; render(); get('#selected-launch').scrollIntoView({ behavior: 'smooth', block: 'start' }); });
      document.querySelectorAll<HTMLButtonElement>('.ll-tabs button').forEach((button) => button.addEventListener('click', () => { const tab = button.dataset.tab; document.querySelectorAll<HTMLButtonElement>('.ll-tabs button').forEach((item) => item.setAttribute('aria-selected', String(item === button))); document.querySelectorAll<HTMLElement>('.ll-tab-panel').forEach((panel) => { panel.hidden = panel.id !== `panel-${tab}`; }); }));
      get('#role-select').addEventListener('change', renderInbox); get('#save-assignment').addEventListener('click', () => { const task = getTasks().find((item) => item.id === assignmentTaskId); if (!task) return; task.owner = get<HTMLSelectElement>('#assignment-owner').value; task.blocked = false; activityByLaunch[selectedId].push(`${task.owner} was assigned ${task.title.toLowerCase()}`); render(); });
      get('#save-schedule').addEventListener('click', () => { const training = getEvents().find((event) => event.title === 'Opening team training'); if (!training) return; training.time = get<HTMLSelectElement>('#new-training-time').value === '09:00' ? '9:00 AM - 11:00 AM' : '2:00 PM - 4:00 PM'; getEvents().forEach((event) => { event.conflict = false; }); activityByLaunch[selectedId].push('Training window updated to remove delivery conflict'); render(); if (tourActive && tourStep === 1) { tourStep = 2; showTab('approvals'); window.setTimeout(() => showGuide(get<HTMLButtonElement>('#open-exception'), 'Step 2 of 3', 'Record the managed decision', 'The timing conflict is resolved, but the delivery is still a launch dependency. Record the owner and mitigation before deciding how to proceed.'), 250); } });
      const populateImpact = () => { const list = get<HTMLUListElement>('#impact-list'); list.replaceChildren(); const items = getTasks().filter((task) => !task.complete).map((task) => task.title); items.forEach((entry) => { const item = document.createElement('li'); item.textContent = entry; list.append(item); }); };
      const openException = () => { const exception = exceptions[selectedId] || { status: 'open' as const, severity: 'medium' }; get<HTMLSelectElement>('#exception-severity').value = exception.severity; get<HTMLSelectElement>('#exception-owner').value = exception.owner || ''; get<HTMLTextAreaElement>('#exception-mitigation').value = exception.mitigation || ''; get('#exception-error').hidden = true; populateImpact(); stopTourGuide(); exceptionDialog.showModal(); };
      const saveException = (mode: 'resolved' | 'accepted') => { const owner = get<HTMLSelectElement>('#exception-owner').value; const mitigation = get<HTMLTextAreaElement>('#exception-mitigation').value.trim(); const error = get('#exception-error'); if (!owner || !mitigation) { error.textContent = 'Choose an accountable owner and describe the mitigation before recording this decision.'; error.hidden = false; return; } exceptions[selectedId] = { status: mode, owner, mitigation, severity: get<HTMLSelectElement>('#exception-severity').value }; const launch = selected(); if (mode === 'resolved') { getTasks().filter((task) => task.blocked).forEach((task) => { task.complete = true; task.blocked = false; }); launch.status = 'On track'; launch.decision = 'Ready for approval'; launch.readiness = 86; activityByLaunch[selectedId].push(`${owner} resolved the launch exception: ${mitigation}`); } else { launch.status = 'Approved'; launch.decision = 'Approved with risk'; launch.readiness = 88; activityByLaunch[selectedId].push(`Maya Chen approved with risk; ${owner} owns mitigation: ${mitigation}`); } exceptionDialog.close(); render(); if (tourActive && tourStep === 2) { tourStep = 3; stopTour(); get('#tour-step').textContent = 'Guided scenario complete'; get('#tour-title').textContent = 'The decision is recorded across the launch record.'; get('#tour-copy').textContent = 'The portfolio, approval state, readiness score, and activity history now show the same decision.'; get('#tour-start').textContent = 'Explore Cadence'; tourDialog.showModal(); } };
      get('#open-exception').addEventListener('click', openException); get('#resolve-exception').addEventListener('click', (event) => { event.preventDefault(); saveException('resolved'); }); get('#accept-risk').addEventListener('click', (event) => { event.preventDefault(); saveException('accepted'); }); get('#approve-launch').addEventListener('click', () => { if (get<HTMLButtonElement>('#approve-launch').disabled) return; const launch = selected(); launch.status = 'Approved'; launch.decision = 'Approved'; activityByLaunch[selectedId].push('Maya Chen recorded opening approval'); render(); });
      get('#show-tour').addEventListener('click', () => { stopTour(); tourStep = 0; get('#tour-step').textContent = 'Guided scenario'; get('#tour-title').textContent = 'Resolve one launch conflict.'; get('#tour-copy').textContent = 'Cadence will take you from a schedule conflict to a recorded decision. You can dismiss at any point.'; get('#tour-start').textContent = 'Start scenario'; tourDialog.showModal(); }); get('#tour-start').addEventListener('click', () => { if (tourStep === 3) { tourDialog.close(); return; } beginTour(); }); get('#tour-dismiss').addEventListener('click', () => { stopTour(); tourDialog.close(); }); get('#tour-popover-dismiss').addEventListener('click', stopTour); window.addEventListener('resize', positionTour); window.addEventListener('scroll', positionTour, { passive: true }); render();
    </script>
  </body>
</html>
