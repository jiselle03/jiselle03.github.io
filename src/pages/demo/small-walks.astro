---
import '../../styles/small-walks.css';
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#111b3a" /><title>Small Walks | Independent Product Demo</title></head>
<body class="sw-body"><main class="sw-app"><header><a class="sw-brand" href="/demo/small-walks/">Small Walks</a><a class="back-link" href="/">Back</a></header>
<section class="sw-hero"><div><p class="sw-kicker">Block 07</p><h1 id="outing-title">Find 3 things.</h1></div><button id="open-book" type="button">Stamps <b id="book-count">2</b></button></section>
<section class="sw-lengths" aria-label="Choose outing length"><button data-length="10" type="button">10 min</button><button data-length="20" class="is-active" type="button">20 min</button><button data-length="40" type="button">40 min</button></section>
<section class="sw-progress" aria-label="Outing progress"><p><span id="find-count">0</span> of 3 finds</p><div><i id="progress-bar"></i></div></section>
<section class="stamp-rack" aria-label="Stamps earned this outing"><span class="is-live">?</span><span>?</span><span>?</span><p id="stamp-copy">First find unlocks a stamp.</p></section>
<section id="find-board" class="find-board" aria-label="Find prompts"></section>
<button id="add-find" class="capture-button" type="button">Add a find</button>
<section id="finished-card" class="finished-card" hidden><div><p class="sw-kicker">Outing complete</p><h2>Three things you noticed.</h2><p>Keep this field card in your walkbook or print it.</p></div><div id="collage" class="collage"></div><button id="print-card" type="button">Print field card</button><button id="new-outing" type="button">Start another walk</button></section>
<section id="walkbook" class="walkbook" hidden><div class="section-head"><div><p class="sw-kicker">Walkbook</p><h2>Saved field cards</h2></div><button id="close-book" type="button">Close</button></div><div id="book-grid" class="book-grid"></div></section>
</main>
<dialog id="walk-brief" class="walk-brief" aria-labelledby="walk-brief-title"><div><p class="sw-kicker">A working scenario</p><h2 id="walk-brief-title">Turn one block into three finds.</h2><ol><li><span>Start</span><strong>Pick a short route around somewhere familiar.</strong></li><li><span>Notice</span><strong>Follow three prompts that change what you look for.</strong></li><li><span>Keep</span><strong>Save the finished field card in this device's walkbook.</strong></li></ol><div><button id="walk-explore" type="button">Explore on my own</button><button id="walk-start" type="button">Start this walk</button></div></div></dialog>
<dialog id="capture-dialog" class="capture-dialog" aria-labelledby="capture-prompt"><form id="capture-form" novalidate><div class="sheet-grip"></div><p class="sw-kicker">Find <span id="capture-number">1</span></p><h2 id="capture-prompt"></h2><label class="photo-slot"><input id="capture-photo" type="file" accept="image/*" /><span id="capture-preview"><b>Add a photo</b><small>Optional · stays on this device</small></span></label><p id="photo-limit" class="sheet-note" hidden>That image is larger than 1.5 MB. It can appear in this outing, but it will not be kept after refresh.</p><label class="note-label">What did you notice?<textarea id="capture-note" rows="3" placeholder="A few words are enough."></textarea><span id="note-error" hidden>Write a note before saving.</span></label><div class="marker-row" aria-label="Choose a visual marker"><button type="button" aria-label="Coral marker" data-marker="coral"></button><button type="button" aria-label="Sun marker" data-marker="sun"></button><button type="button" aria-label="Moss marker" data-marker="moss"></button><button type="button" aria-label="Ink marker" data-marker="ink"></button></div><div class="sheet-actions"><button id="cancel-capture" type="button">Cancel</button><button type="submit">Save find</button></div></form></dialog>
<script>
type Find = { prompt: string; note: string; marker: string; photo?: string; persistPhoto: boolean }; type Outing = { title: string; length: number; finds: Find[]; date: string };
const prompts = ['Find something repaired by hand.', 'Find a color you did not expect.', 'Find a thing that has been waiting.']; const markers = ['coral','sun','moss','ink']; const key = 'small-walks-field-notes'; let length = 20; let selectedMarker = 'coral'; let photo = ''; let persistPhoto = true; let outing: Outing = { title:'Side Street', length, finds:[], date:new Intl.DateTimeFormat('en',{month:'short',day:'numeric'}).format(new Date()) };
const get=<T extends HTMLElement>(s:string)=>{const e=document.querySelector<T>(s);if(!e)throw new Error(s);return e}; const board=get('#find-board'); const dialog=get<HTMLDialogElement>('#capture-dialog'); const photoPreview=get('#capture-preview'); const note=get<HTMLTextAreaElement>('#capture-note'); const bookGrid=get('#book-grid'); let saved:Outing[]=[];try{saved=JSON.parse(localStorage.getItem(key)||'[]')}catch{saved=[]}
const save=()=>{try{localStorage.setItem(key,JSON.stringify(saved))}catch{}}; const esc=(value:string)=>value.replace(/[&<>"]/g,(char)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[char]!));
const visual=(find?:Find)=>`<div class="find-visual ${find?.marker||'empty'}"${find?.photo?` style="background-image:url('${find.photo}')"`:''}>${find?.photo?'':`<span>${find?'noted':'next find'}</span>`}</div>`;
const render=()=>{const count=outing.finds.length;get('#find-count').textContent=String(count);get('#progress-bar').style.width=`${count/3*100}%`;document.querySelectorAll<HTMLElement>('.stamp-rack span').forEach((stamp,index)=>{stamp.classList.toggle('is-earned',index<count);stamp.textContent=index<count?['#','!','+'][index]:'?';});get('#stamp-copy').textContent=count===0?'First find unlocks a stamp.':count===3?'Block complete. Three stamps earned.':`${3-count} stamp${3-count===1?'':'s'} left.`;board.innerHTML=prompts.map((prompt,index)=>{const find=outing.finds[index];return `<article class="find-card ${find?'is-done':''} ${index===count?'is-active':''}"><div class="find-number">0${index+1}</div>${visual(find)}<div><p>${find?'Found':index===count?'Now':'Later'}</p><h2>${find?esc(find.note):prompt}</h2><span>${find?prompt:index===count?'Add a photo or choose a marker.':'Finish the earlier find first.'}</span></div></article>`}).join('');get('#add-find').toggleAttribute('hidden',count>=3);get('#finished-card').hidden=count<3; if(count===3){get('#collage').innerHTML=outing.finds.map((find)=>visual(find)).join('');}};
const renderBook=()=>{get('#book-count').textContent=String(saved.length);bookGrid.innerHTML=saved.length?saved.slice().reverse().map((entry)=>`<article><div class="mini-collage">${entry.finds.map((find)=>visual(find)).join('')}</div><p>${entry.date} · ${entry.length} min</p><h3>${entry.title}</h3></article>`).join(''):'<p class="empty-book">Your finished walks will appear here.</p>';};
const openCapture=()=>{const index=outing.finds.length;if(index>=3)return;get('#capture-number').textContent=String(index+1);get('#capture-prompt').textContent=prompts[index];note.value='';photo='';persistPhoto=true;selectedMarker=markers[index%markers.length];photoPreview.className='';photoPreview.innerHTML='<b>Add a photo</b><small>Optional · stays on this device</small>';get('#photo-limit').hidden=true;get('#note-error').hidden=true;document.querySelectorAll('.marker-row button').forEach((item,markerIndex)=>item.classList.toggle('is-selected',markerIndex===index%markers.length));dialog.showModal();};
get('#add-find').addEventListener('click',openCapture);document.querySelectorAll<HTMLButtonElement>('.sw-lengths button').forEach(button=>button.addEventListener('click',()=>{if(outing.finds.length)return;length=Number(button.dataset.length);document.querySelectorAll('.sw-lengths button').forEach(item=>item.classList.toggle('is-active',item===button));render();}));
get<HTMLInputElement>('#capture-photo').addEventListener('change',(event)=>{const file=(event.target as HTMLInputElement).files?.[0];if(!file)return;persistPhoto=file.size<=1500000;get('#photo-limit').hidden=persistPhoto;const reader=new FileReader();reader.addEventListener('load',()=>{photo=String(reader.result);photoPreview.style.backgroundImage=`url(${photo})`;photoPreview.className='has-photo';photoPreview.innerHTML='<b>Change photo</b>';});reader.readAsDataURL(file);});document.querySelectorAll<HTMLButtonElement>('.marker-row button').forEach((button,index)=>button.addEventListener('click',()=>{selectedMarker=markers[index];document.querySelectorAll('.marker-row button').forEach(item=>item.classList.toggle('is-selected',item===button));}));
const walkBrief=get<HTMLDialogElement>('#walk-brief');const markWalkBriefSeen=()=>{try{sessionStorage.setItem('small-walks-brief-seen','true')}catch{}};get('#walk-start').addEventListener('click',()=>{markWalkBriefSeen();walkBrief.close();openCapture();});get('#walk-explore').addEventListener('click',()=>{markWalkBriefSeen();walkBrief.close();get('#find-board').scrollIntoView({behavior:'smooth',block:'start'});});get<HTMLFormElement>('#capture-form').addEventListener('submit',(event)=>{event.preventDefault();if(!note.value.trim()){get('#note-error').hidden=false;return;}outing.finds.push({prompt:prompts[outing.finds.length],note:note.value.trim(),marker:selectedMarker,photo:photo||undefined,persistPhoto});dialog.close();document.body.classList.add('stamp-flash');window.setTimeout(()=>document.body.classList.remove('stamp-flash'),500);render();});get('#cancel-capture').addEventListener('click',()=>dialog.close());get('#new-outing').addEventListener('click',()=>{const storable={...outing,finds:outing.finds.map(find=>({...find,photo:find.persistPhoto?find.photo:undefined}))};saved.push(storable);save();outing={title:'Side Street',length,finds:[],date:new Intl.DateTimeFormat('en',{month:'short',day:'numeric'}).format(new Date())};render();renderBook();window.scrollTo({top:0,behavior:'smooth'});});get('#open-book').addEventListener('click',()=>{get('#walkbook').hidden=false;get('#walkbook').scrollIntoView({behavior:'smooth'});});get('#close-book').addEventListener('click',()=>get('#walkbook').hidden=true);get('#print-card').addEventListener('click',()=>window.print());render();renderBook();try{if(!sessionStorage.getItem('small-walks-brief-seen'))window.setTimeout(()=>walkBrief.showModal(),250)}catch{window.setTimeout(()=>walkBrief.showModal(),250)}
</script></body></html>
