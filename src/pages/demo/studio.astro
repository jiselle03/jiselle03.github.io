---
import '../../styles/studio.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Set is a fictional frontend-only fitness class booking product concept by Jiselle Liu." />
    <meta name="theme-color" content="#17223e" />
    <title>Set | Independent Product Demo</title>
  </head>
  <body>
    <a class="sf-skip" href="#studio-main">Skip to main content</a>
    <main id="studio-main" class="sf-app" tabindex="-1">
      <header class="sf-header">
        <a class="sf-brand" href="/demo/studio/"><span class="sf-brand-mark" aria-hidden="true"><i></i><i></i><i></i></span><span>Set</span></a>
        <div class="sf-mode-switch" role="group" aria-label="Choose a workspace"><button type="button" data-mode="member" aria-pressed="true">Member</button><button type="button" data-mode="studio" aria-pressed="false">Studio</button></div>
        <div class="sf-credit-balance"><span>Available</span><strong id="credit-balance">6</strong><small>credits</small></div>
      </header>
      <p class="sf-demo-notice"><strong>Frontend sample</strong><span>Fictional data and browser-only interactions reset when you refresh.</span></p>
      <nav class="sf-member-nav" aria-label="Member workspace"><button type="button" data-view="explore" aria-current="page">Explore classes</button><button type="button" data-view="schedule">My schedule</button></nav>

      <section class="sf-view" data-view-panel="explore">
        <div class="sf-page-heading"><div><p class="sf-kicker">This week in Taipei</p><h1>Choose a class for Thursday.</h1><p>Book group classes or 1:1 sessions with the credits you already have.</p></div><button id="restart-scenario" class="sf-quiet-action" type="button">Restart scenario</button></div>
        <div class="sf-filter-row" aria-label="Filter classes by format"><button type="button" data-filter="all" aria-pressed="true">All classes</button><button type="button" data-filter="pilates" aria-pressed="false">Pilates</button><button type="button" data-filter="combat" aria-pressed="false">Combat</button><button type="button" data-filter="climbing" aria-pressed="false">Climbing</button><button type="button" data-filter="strength" aria-pressed="false">Strength</button></div>
        <div class="sf-explore-layout"><section><div class="sf-section-head"><div><p class="sf-kicker">Available sessions</p><h2>Thursday, September 18</h2></div><span id="class-count"></span></div><div id="class-list" class="sf-class-list"></div></section><aside id="class-detail" class="sf-class-detail" aria-live="polite"></aside></div>
      </section>

      <section class="sf-view" data-view-panel="schedule" hidden>
        <div class="sf-page-heading"><div><p class="sf-kicker">Your bookings</p><h1>My schedule</h1><p>Everything you have booked, joined, or changed in one place.</p></div></div>
        <div class="sf-schedule-layout"><section id="schedule-list" class="sf-schedule-list" aria-live="polite"></section><aside class="sf-credit-card"><p class="sf-kicker">Credit balance</p><strong id="schedule-credit-balance">6</strong><span>credits ready to book</span><hr /><p id="credit-note">Your membership renews October 1.</p></aside></div>
      </section>

      <section class="sf-view" data-view-panel="studio" hidden>
        <div class="sf-page-heading"><div><p class="sf-kicker">Studio operations</p><h1>Studio manager</h1><p>Upcoming sessions, enrolled members, and changes across your locations.</p></div><div class="sf-studio-actions"><button id="restart-studio-tour" class="sf-quiet-action" type="button">Studio tour</button><button id="open-class-dialog" class="sf-primary-action" type="button">Add class</button></div></div>
        <section id="studio-metrics" class="sf-studio-metrics" aria-label="Today’s studio metrics" aria-live="polite"></section>
        <div class="sf-studio-grid"><section class="sf-studio-panel"><p class="sf-kicker">Today</p><h2>Class roster</h2><div id="studio-roster" class="sf-roster"></div></section><section class="sf-studio-panel"><p class="sf-kicker">Member changes</p><h2>Recent activity</h2><ol id="activity-list" class="sf-activity"></ol></section></div>
      </section>

      <footer>Fictional frontend demo by <a href="/">Jiselle Liu</a></footer>
    </main>

    <dialog id="scenario-brief" class="sf-dialog" aria-labelledby="scenario-title"><div><p class="sf-kicker">A working scenario</p><h2 id="scenario-title">Your Thursday plans changed.</h2><ol><li><span>Starting point</span><strong>You have 6 credits and Thursday evening free.</strong></li><li><span>First booking</span><strong>Book a 1:1 bouldering session for 4 credits.</strong></li><li><span>Change of plans</span><strong>Cancel in time, receive the credits back, then book a 2-credit group class.</strong></li></ol><div class="sf-dialog-actions"><button id="scenario-explore" class="sf-quiet-action" type="button">Explore on my own</button><button id="scenario-start" class="sf-primary-action" type="button">Start guided scenario</button></div></div></dialog>
    <dialog id="booking-dialog" class="sf-dialog sf-confirm-dialog" aria-labelledby="booking-title"><div><p class="sf-kicker">Confirm booking</p><h2 id="booking-title">Book this class?</h2><p id="booking-copy"></p><div class="sf-dialog-actions"><button id="booking-cancel" class="sf-quiet-action" type="button">Keep exploring</button><button id="booking-confirm" class="sf-primary-action" type="button">Confirm booking</button></div></div></dialog>
    <dialog id="cancellation-dialog" class="sf-dialog sf-confirm-dialog" aria-labelledby="cancellation-title"><div><p class="sf-kicker">Confirm cancellation</p><h2 id="cancellation-title">Cancel this class?</h2><p id="cancellation-copy"></p><div class="sf-dialog-actions"><button id="cancellation-dismiss" class="sf-quiet-action" type="button">Keep this class</button><button id="cancellation-confirm" class="sf-primary-action" type="button">Cancel class</button></div></div></dialog>
    <dialog id="waitlist-dialog" class="sf-dialog sf-waitlist-dialog" aria-labelledby="waitlist-title"><div><p class="sf-kicker">Join the waitlist</p><h2 id="waitlist-title">Join this class?</h2><p id="waitlist-copy">If a space opens, you will be automatically enrolled and your credits will be used.</p><div class="sf-dialog-actions"><button id="waitlist-cancel" class="sf-quiet-action" type="button">Not now</button><button id="waitlist-confirm" class="sf-primary-action" type="button">Join waitlist</button></div></div></dialog>
    <dialog id="studio-brief" class="sf-dialog" aria-labelledby="studio-brief-title"><div><p class="sf-kicker">A studio scenario</p><h2 id="studio-brief-title">There is an open 8:45 PM slot.</h2><p class="sf-dialog-copy">Add a mobility class, then see it appear in the day’s roster and member catalog.</p><div class="sf-dialog-actions"><button id="studio-explore" class="sf-quiet-action" type="button">Explore on my own</button><button id="studio-start" class="sf-primary-action" type="button">Start studio tour</button></div></div></dialog>
    <dialog id="class-dialog" class="sf-dialog sf-class-dialog" aria-labelledby="class-dialog-title"><form id="class-form"><p class="sf-kicker">New class</p><h2 id="class-dialog-title">Add an evening session</h2><label>Class name<input id="new-class-name" name="name" value="Mobility reset" required /></label><label>Start time<input id="new-class-time" name="time" type="time" value="20:45" required /></label><label>Capacity<input id="new-class-capacity" name="capacity" type="number" min="1" max="30" value="8" required /></label><div class="sf-dialog-actions"><button id="class-dialog-cancel" class="sf-quiet-action" type="button">Discard</button><button class="sf-primary-action" type="submit">Add class</button></div></form></dialog>
    <dialog id="class-confirmation-dialog" class="sf-dialog sf-confirm-dialog" aria-labelledby="class-confirmation-title"><div><p id="class-confirmation-kicker" class="sf-kicker">Confirm class</p><h2 id="class-confirmation-title">Add this class?</h2><p id="class-confirmation-copy"></p><div class="sf-dialog-actions"><button id="class-confirmation-back" class="sf-quiet-action" type="button">Edit class</button><button id="class-confirmation-submit" class="sf-primary-action" type="button">Add class</button></div></div></dialog>
    <aside id="tour-sheet" class="sf-tour-sheet" aria-live="polite" hidden><p id="tour-step" class="sf-kicker"></p><strong id="tour-title"></strong><p id="tour-copy"></p><button id="tour-dismiss" type="button">Dismiss guide</button></aside>
    <aside id="studio-tour-sheet" class="sf-tour-sheet" aria-live="polite" hidden><p class="sf-kicker">Studio tour</p><strong id="studio-tour-title"></strong><p id="studio-tour-copy"></p><button id="studio-tour-dismiss" type="button">Dismiss guide</button></aside>

    <script>
      type ClassSession = { id: string; name: string; category: 'pilates' | 'combat' | 'climbing' | 'strength'; format: 'Group' | '1:1'; credits: number; time: string; duration: string; studio: string; instructor: string; level: string; capacity: string; availability: number; cancellation: string; description: string; };
      const sessions: ClassSession[] = [
        { id: 'reformer', name: 'Reformer fundamentals', category: 'pilates', format: 'Group', credits: 2, time: '6:15 PM', duration: '50 min', studio: 'Form House', instructor: 'Nina Hsu', level: 'Beginner', capacity: '4 of 10 spots left', availability: 4, cancellation: 'Cancel by 6:15 PM Wednesday for all credits back.', description: 'A steady-paced introduction to spring resistance, form, and core control.' },
        { id: 'lagree', name: 'Lagree strength', category: 'pilates', format: 'Group', credits: 2, time: '7:30 PM', duration: '45 min', studio: 'Form House', instructor: 'Nina Hsu', level: 'All levels', capacity: 'Waitlist only', availability: 0, cancellation: 'Cancel by 7:30 PM Wednesday for all credits back.', description: 'Low-impact, high-intensity work on the Megaformer.' },
        { id: 'kickboxing', name: 'Technique kickboxing', category: 'combat', format: 'Group', credits: 2, time: '8:00 PM', duration: '60 min', studio: 'Northside Gym', instructor: 'Leon Wu', level: 'Beginner', capacity: '6 of 16 spots left', availability: 6, cancellation: 'Cancel by noon Thursday for all credits back.', description: 'Footwork, combinations, and bag work with a small group.' },
        { id: 'bouldering', name: '1:1 bouldering intro', category: 'climbing', format: '1:1', credits: 4, time: '7:00 PM', duration: '60 min', studio: 'Stone Club', instructor: 'Mina Ko', level: 'New to bouldering', capacity: '1 session available', availability: 1, cancellation: 'Cancel by 7:00 PM Wednesday for all 4 credits back.', description: 'A private first session covering movement, route reading, and safe falling.' },
        { id: 'strength', name: 'Barbell basics', category: 'strength', format: 'Group', credits: 2, time: '6:30 PM', duration: '60 min', studio: 'Lift Lab', instructor: 'Sora Lin', level: 'Beginner', capacity: '3 of 8 spots left', availability: 3, cancellation: 'Cancel by 6:30 PM Wednesday for all credits back.', description: 'Learn the squat, hinge, press, and pull with coaching and space to practice.' },
      ];
      const baseSessionCount = sessions.length;
      let selectedId = 'bouldering'; let filter = 'all'; let credits = 6; let bookingId = ''; let waitlistId = ''; let pendingWaitlistId = ''; let pendingBookingId = ''; let pendingStudioClass: ClassSession | null = null; let mode = 'member'; let tourStep = 0; const cancelledIds: string[] = [];
      const activity = ['Membership renewed: 6 credits added'];
      const studioEnrollees: Record<string, string[]> = {
        bouldering: [],
        lagree: ['Aiko Chen', 'Mei Lin', 'Rina Wu', 'Tommy Hsu', 'Hana Chou', 'Bea Huang', 'Ivy Kao', 'Claire Lo', 'Jia Chen', 'May Lin'],
        kickboxing: ['Noah Yeh', 'Eli Chang', 'Yuki Chen', 'Zoe Liu', 'Leo Hsu', 'Mia Wang', 'Sam Wu', 'Yen Kao', 'Ari Lin', 'Ben Ho'],
      };
      const sessionCapacity: Record<string, number> = { bouldering: 1, lagree: 10, kickboxing: 16 };
      const demoMemberName = 'Alex Park';
      const get = <T extends HTMLElement>(selector: string) => { const element = document.querySelector<T>(selector); if (!element) throw new Error(`Missing ${selector}`); return element; };
      const selected = () => sessions.find((session) => session.id === selectedId)!;
      const availableSessions = () => sessions.filter((session) => filter === 'all' || session.category === filter);
      const setView = (view: string, focus = false) => { document.querySelectorAll<HTMLElement>('[data-view-panel]').forEach((panel) => { panel.hidden = panel.dataset.viewPanel !== view; }); document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((button) => { if (button.dataset.view === view) button.setAttribute('aria-current', 'page'); else button.removeAttribute('aria-current'); }); if (focus) get('#studio-main').focus(); };
      const setMode = (nextMode: string, focus = false) => { mode = nextMode; const isMember = mode === 'member'; get<HTMLElement>('.sf-member-nav').hidden = !isMember; get<HTMLElement>('.sf-credit-balance').hidden = !isMember; document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.mode === mode))); setView(isMember ? 'explore' : 'studio', focus); if (!isMember) { try { if (!sessionStorage.getItem('set-studio-tour-seen')) window.setTimeout(() => get<HTMLDialogElement>('#studio-brief').showModal(), 180); } catch {} } };
      const updateCredits = () => { get('#credit-balance').textContent = String(credits); get('#schedule-credit-balance').textContent = String(credits); };
      const showGuide = (step: number, title: string, copy: string) => { tourStep = step; get('#tour-step').textContent = `Guided scenario · ${step} of 3`; get('#tour-title').textContent = title; get('#tour-copy').textContent = copy; get('#tour-sheet').hidden = false; };
      const stopGuide = () => { tourStep = 0; get('#tour-sheet').hidden = true; };
      const showStudioGuide = (title: string, copy: string) => { get('#studio-tour-title').textContent = title; get('#studio-tour-copy').textContent = copy; get('#studio-tour-sheet').hidden = false; };
      const stopStudioGuide = () => { get('#studio-tour-sheet').hidden = true; };
      const renderExplore = () => { const list = get<HTMLDivElement>('#class-list'); const detail = get<HTMLDivElement>('#class-detail'); const items = availableSessions(); get('#class-count').textContent = `${items.length} sessions`; list.replaceChildren(); items.forEach((session) => { const card = document.createElement('button'); card.type = 'button'; card.className = `sf-class-card${session.id === selectedId ? ' is-selected' : ''}`; card.innerHTML = `<span class="sf-class-time">${session.time}</span><span><small>${session.format} · ${session.level}</small><strong>${session.name}</strong><em>${session.studio} · ${session.instructor}</em></span><b>${session.credits} credits</b>`; card.addEventListener('click', () => { selectedId = session.id; renderExplore(); }); list.append(card); }); const session = selected(); const isBooked = bookingId === session.id; const isWaitlisted = waitlistId === session.id; const canBook = !bookingId && credits >= session.credits && session.availability > 0; detail.innerHTML = `<p class="sf-kicker">${session.format} · ${session.level}</p><h2>${session.name}</h2><p>${session.description}</p><dl><div><dt>When</dt><dd>Thursday · ${session.time}<br />${session.duration}</dd></div><div><dt>Where</dt><dd>${session.studio}<br />with ${session.instructor}</dd></div><div><dt>Availability</dt><dd>${session.capacity}</dd></div><div><dt>Cancellation</dt><dd>${session.cancellation}</dd></div></dl><div class="sf-detail-actions"><span><strong>${session.credits}</strong> credits</span>${session.availability === 0 ? `<button id="waitlist-button" class="sf-quiet-action" type="button" ${isWaitlisted ? 'disabled' : ''}>${isWaitlisted ? 'On waitlist' : 'Join waitlist'}</button>` : `<button id="booking-button" class="sf-primary-action" type="button" ${canBook ? '' : 'disabled'}>${isBooked ? 'Booked' : credits < session.credits ? 'Not enough credits' : bookingId ? 'Another class booked' : 'Book class'}</button>`}</div>`; document.querySelector<HTMLButtonElement>('#booking-button')?.addEventListener('click', () => openBookingConfirmation(session)); document.querySelector<HTMLButtonElement>('#waitlist-button')?.addEventListener('click', () => openWaitlist(session)); };
      const renderSchedule = () => { const list = get<HTMLDivElement>('#schedule-list'); const parts: string[] = []; if (bookingId) { const session = sessions.find((item) => item.id === bookingId)!; parts.push(`<section class="sf-schedule-section"><p class="sf-kicker">Upcoming</p><article class="sf-booking"><div><p class="sf-kicker">Thursday, September 18</p><h2>${session.name}</h2><p>${session.time} · ${session.duration}<br />${session.studio} with ${session.instructor}</p></div><div><span class="sf-booking-status">Booked</span><strong>${session.credits} credits used</strong></div><div class="sf-booking-policy"><strong>Eligible for a credit refund</strong><span>${session.cancellation}</span></div><button id="cancel-booking" class="sf-quiet-action" type="button">Cancel and return credits</button></article></section>`); } if (waitlistId) { const session = sessions.find((item) => item.id === waitlistId)!; parts.push(`<section class="sf-schedule-section"><p class="sf-kicker">Waitlist</p><article class="sf-waitlist-card"><div><h2>${session.name}</h2><p>Thursday · ${session.time} · ${session.studio}</p></div><span>Auto-enrollment on</span><p>If a space opens, you will be enrolled automatically and ${session.credits} credits will be used.</p></article></section>`); } if (cancelledIds.length) { const cancelled = cancelledIds.map((id) => sessions.find((session) => session.id === id)!).map((session) => `<li><strong>${session.name}</strong><span>Cancelled in time · ${session.credits} credits returned</span></li>`).join(''); parts.push(`<section class="sf-schedule-section"><p class="sf-kicker">Recent changes</p><ol class="sf-cancelled-list">${cancelled}</ol></section>`); } if (!parts.length) parts.push('<div class="sf-empty"><strong>No bookings yet.</strong><p>Choose a class from Explore to build your week.</p><button id="empty-explore" class="sf-primary-action" type="button">Explore classes</button></div>'); list.innerHTML = parts.join(''); document.querySelector<HTMLButtonElement>('#cancel-booking')?.addEventListener('click', openCancellationConfirmation); document.querySelector<HTMLButtonElement>('#empty-explore')?.addEventListener('click', () => { setMode('member'); setView('explore', true); }); get('#credit-note').textContent = bookingId ? 'Your booked class is held with credits, not a real payment.' : 'Your membership renews October 1.'; };
      const renderStudio = () => { const enrolledFor = (id: string) => [...(studioEnrollees[id] || []), ...(bookingId === id ? [demoMemberName] : [])]; const studioSessions = [...['bouldering', 'lagree', 'kickboxing'].map((id) => sessions.find((session) => session.id === id)!), ...sessions.slice(baseSessionCount)]; const capacityFor = (session: ClassSession) => sessionCapacity[session.id] || session.availability; const bookedSeats = studioSessions.reduce((total, session) => total + enrolledFor(session.id).length, 0); const totalSeats = studioSessions.reduce((total, session) => total + capacityFor(session), 0); get('#studio-metrics').innerHTML = `<article><span>Upcoming</span><strong>${studioSessions.length}</strong><small>classes today</small></article><article><span>Booked seats</span><strong>${bookedSeats}</strong><small>of ${totalSeats} available</small></article><article><span>Waitlist</span><strong>${waitlistId ? '1' : '0'}</strong><small>${waitlistId ? 'member queued' : 'no members queued'}</small></article>`; const roster = get<HTMLDivElement>('#studio-roster'); roster.replaceChildren(); studioSessions.forEach((session) => { const enrollees = enrolledFor(session.id); const article = document.createElement('article'); if (session.id.startsWith('studio-')) article.className = 'sf-roster-new'; article.innerHTML = `<div class="sf-roster-summary"><span>${session.name}</span><strong>${enrollees.length} of ${capacityFor(session)} booked${waitlistId === session.id ? ' · 1 waitlisted' : ''}</strong><small>${session.instructor} · ${session.time}</small></div>${enrollees.length ? `<details class="sf-enrollee-list"><summary>View ${enrollees.length} enrolled</summary><ul>${enrollees.map((name) => `<li>${name}</li>`).join('')}</ul></details>` : `<p class="sf-roster-empty">${session.id.startsWith('studio-') ? 'Newly added. No members enrolled yet.' : 'No members enrolled yet.'}</p>`}`; roster.append(article); }); const activityList = get<HTMLOListElement>('#activity-list'); activityList.replaceChildren(); activity.forEach((entry) => { const item = document.createElement('li'); item.textContent = entry; activityList.append(item); }); };
      const render = () => { updateCredits(); renderExplore(); renderSchedule(); renderStudio(); };
      const openBookingConfirmation = (session: ClassSession) => { pendingBookingId = session.id; get('#booking-title').textContent = `Book ${session.name}?`; get('#booking-copy').textContent = `${session.credits} credits will be deducted from your account. You will have ${credits - session.credits} credits left.`; get<HTMLDialogElement>('#booking-dialog').showModal(); };
      const book = (session: ClassSession) => { if (bookingId || credits < session.credits || session.availability === 0) return; bookingId = session.id; pendingBookingId = ''; credits -= session.credits; activity.unshift(`Booked ${session.name} using ${session.credits} credits`); render(); setView('schedule'); if (tourStep === 1 && session.id === 'bouldering') showGuide(2, 'Your booking is confirmed', 'Open the cancellation option to see how a timely change returns all 4 credits.'); if (tourStep === 3 && session.id === 'kickboxing') showGuide(3, 'Scenario complete', 'You used 2 credits for a group class. Your schedule, balance, and the studio roster now agree.'); };
      const confirmBooking = () => { const session = sessions.find((item) => item.id === pendingBookingId); if (!session) return; get<HTMLDialogElement>('#booking-dialog').close(); book(session); };
      const openCancellationConfirmation = () => { if (!bookingId) return; const session = sessions.find((item) => item.id === bookingId)!; get('#cancellation-title').textContent = `Cancel ${session.name}?`; get('#cancellation-copy').textContent = `${session.credits} credits will be returned to your account. You will have ${credits + session.credits} credits available.`; get<HTMLDialogElement>('#cancellation-dialog').showModal(); };
      const cancelBooking = () => { if (!bookingId) return; const session = sessions.find((item) => item.id === bookingId)!; credits += session.credits; cancelledIds.unshift(session.id); activity.unshift(`Cancelled ${session.name}; ${session.credits} credits returned`); bookingId = ''; render(); if (tourStep === 2) { selectedId = 'kickboxing'; setView('explore'); render(); showGuide(3, 'Pick a group class instead', 'Book Technique kickboxing for 2 credits. Your available balance and studio roster will update together.'); } };
      const openWaitlist = (session: ClassSession) => { pendingWaitlistId = session.id; get('#waitlist-title').textContent = `Join the waitlist for ${session.name}?`; get('#waitlist-copy').textContent = `If a space opens for Thursday at ${session.time}, you will be automatically enrolled and ${session.credits} credits will be used.`; get<HTMLDialogElement>('#waitlist-dialog').showModal(); };
      const confirmWaitlist = () => { const session = sessions.find((item) => item.id === pendingWaitlistId); if (!session) return; waitlistId = session.id; activity.unshift(`Joined the waitlist for ${session.name}; auto-enrollment enabled`); get<HTMLDialogElement>('#waitlist-dialog').close(); render(); };
      const openClassDialog = () => get<HTMLDialogElement>('#class-dialog').showModal();
      const stageStudioClass = (event: SubmitEvent) => { event.preventDefault(); const form = new FormData(get<HTMLFormElement>('#class-form')); const name = String(form.get('name') || '').trim(); const time = String(form.get('time') || ''); const capacity = Number(form.get('capacity')); if (!name || !time || !Number.isFinite(capacity) || capacity < 1) return; const formattedTime = new Intl.DateTimeFormat('en', { hour: 'numeric', minute: '2-digit' }).format(new Date(`2026-09-18T${time}:00`)); pendingStudioClass = { id: `studio-${Date.now()}`, name, category: 'strength', format: 'Group', credits: 2, time: formattedTime, duration: '45 min', studio: 'Form House', instructor: 'Studio team', level: 'All levels', capacity: `${capacity} spots left`, availability: capacity, cancellation: 'Cancel at least 12 hours before class for all credits back.', description: 'A short recovery-focused class created from the studio workspace.' }; const conflict = sessions.find((session) => session.studio === pendingStudioClass!.studio && session.time === formattedTime); get('#class-confirmation-kicker').textContent = conflict ? 'Scheduling conflict' : 'Confirm class'; get('#class-confirmation-title').textContent = conflict ? `Add ${name} anyway?` : `Add ${name}?`; get('#class-confirmation-copy').textContent = conflict ? `${conflict.name} is already scheduled at ${formattedTime} at ${pendingStudioClass.studio}. This new class will overlap it.` : `This 2-credit class will be listed for members at ${pendingStudioClass.studio} at ${formattedTime} with ${capacity} seats.`; get<HTMLDialogElement>('#class-dialog').close(); get<HTMLDialogElement>('#class-confirmation-dialog').showModal(); };
      const addStudioClass = () => { if (!pendingStudioClass) return; sessions.push(pendingStudioClass); activity.unshift(`Added ${pendingStudioClass.name} at ${pendingStudioClass.time} with ${pendingStudioClass.availability} seats`); const { name, availability } = pendingStudioClass; pendingStudioClass = null; get<HTMLDialogElement>('#class-confirmation-dialog').close(); render(); showStudioGuide('Your class is now on the schedule', `${name} is in the member catalog and today’s roster with ${availability} open seats.`); };
      const resetScenario = () => { credits = 6; bookingId = ''; waitlistId = ''; pendingWaitlistId = ''; pendingBookingId = ''; pendingStudioClass = null; sessions.splice(baseSessionCount); cancelledIds.splice(0); selectedId = 'bouldering'; filter = 'all'; activity.splice(0, activity.length, 'Membership renewed: 6 credits added'); document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === 'all'))); render(); setMode('member'); setView('explore'); showGuide(1, 'Start with the 1:1 session', 'Open 1:1 bouldering intro and book it for 4 credits. The class detail explains the cancellation rule before you commit.'); };
      document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((button) => button.addEventListener('click', () => setMode(button.dataset.mode || 'member', true))); document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((button) => button.addEventListener('click', () => setView(button.dataset.view || 'explore', true))); document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => button.addEventListener('click', () => { filter = button.dataset.filter || 'all'; document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((item) => item.setAttribute('aria-pressed', String(item === button))); const first = availableSessions()[0]; if (first) selectedId = first.id; renderExplore(); })); get('#restart-scenario').addEventListener('click', resetScenario); get('#tour-dismiss').addEventListener('click', stopGuide); get('#restart-studio-tour').addEventListener('click', () => showStudioGuide('Add an evening class', 'Use Add class to create a mobility session. The roster and today’s class count will update.')); get('#open-class-dialog').addEventListener('click', openClassDialog); get<HTMLFormElement>('#class-form').addEventListener('submit', stageStudioClass); get('#class-dialog-cancel').addEventListener('click', () => get<HTMLDialogElement>('#class-dialog').close()); get('#class-confirmation-submit').addEventListener('click', addStudioClass); get('#class-confirmation-back').addEventListener('click', () => { get<HTMLDialogElement>('#class-confirmation-dialog').close(); openClassDialog(); }); get('#studio-tour-dismiss').addEventListener('click', stopStudioGuide); get('#studio-start').addEventListener('click', () => { try { sessionStorage.setItem('set-studio-tour-seen', 'true'); } catch {} get<HTMLDialogElement>('#studio-brief').close(); showStudioGuide('Add an evening class', 'Use Add class to create a mobility session. The roster and today’s class count will update.'); }); get('#studio-explore').addEventListener('click', () => { try { sessionStorage.setItem('set-studio-tour-seen', 'true'); } catch {} get<HTMLDialogElement>('#studio-brief').close(); }); get('#booking-confirm').addEventListener('click', confirmBooking); get('#booking-cancel').addEventListener('click', () => get<HTMLDialogElement>('#booking-dialog').close()); get('#cancellation-confirm').addEventListener('click', () => { get<HTMLDialogElement>('#cancellation-dialog').close(); cancelBooking(); }); get('#cancellation-dismiss').addEventListener('click', () => get<HTMLDialogElement>('#cancellation-dialog').close()); get('#waitlist-confirm').addEventListener('click', confirmWaitlist); get('#waitlist-cancel').addEventListener('click', () => get<HTMLDialogElement>('#waitlist-dialog').close()); get('#scenario-start').addEventListener('click', () => { try { sessionStorage.setItem('set-scenario-seen', 'true'); } catch {} get<HTMLDialogElement>('#scenario-brief').close(); resetScenario(); }); get('#scenario-explore').addEventListener('click', () => { try { sessionStorage.setItem('set-scenario-seen', 'true'); } catch {} get<HTMLDialogElement>('#scenario-brief').close(); }); render(); setMode(mode); try { if (!sessionStorage.getItem('set-scenario-seen')) window.setTimeout(() => get<HTMLDialogElement>('#scenario-brief').showModal(), 250); } catch { window.setTimeout(() => get<HTMLDialogElement>('#scenario-brief').showModal(), 250); }
    </script>
