      const restoreAdminAndPartnerData = () => { Object.entries(initialAdminProfiles).forEach(([id, profile]) => { adminProfiles[id] = { ...profile }; }); selectedAdminMember = 'alex'; adminOperatorContext = false; get<HTMLSelectElement>('#admin-role-context').value = 'Admin'; get('#admin-support-status').textContent = ''; get('#support-case-status').textContent = ''; Object.entries(initialSupportCases).forEach(([id, item]) => { supportCases[id] = { ...item }; }); renderSupportCase('credit'); get('#admin-activity').replaceChildren(...['Directory opened by Priya Shah', 'Membership record verified', 'Credit renewal posted'].map((copy, index) => { const row = document.createElement('li'); const when = document.createElement('strong'); when.textContent = ['09:41', '09:38', 'Yesterday'][index]; const detail = document.createElement('span'); detail.textContent = copy; row.append(when, detail); return row; })); const partnerStatus = ['Active · 4 staff · 12 classes', 'Active · 7 staff · 18 classes', 'Review due · 3 staff · 8 classes', 'Active · 5 staff · 10 classes']; document.querySelectorAll<HTMLButtonElement>('[data-partner-toggle]').forEach((button, index) => { button.setAttribute('aria-pressed', 'false'); button.textContent = 'Disable'; const label = button.closest('.sf-directory-entry')?.querySelector('small'); if (label) label.textContent = partnerStatus[index] || 'Active'; }); document.querySelectorAll<HTMLSelectElement>('[data-partner-role]').forEach((select) => { select.selectedIndex = 0; updatePartnerRole(select.dataset.partnerRole || 'Staff member', select.value); }); renderAdmin(); };
      get('#restart-demo-scenario').addEventListener('click', () => { const currentMode = mode; stopGuide(); stopStudioGuide(); document.querySelectorAll<HTMLDialogElement>('#scenario-brief, #studio-brief, #admin-brief').forEach((brief) => { if (brief.open) brief.close(); }); resetScenario(); restoreAdminAndPartnerData(); if (currentMode !== 'member') { stopGuide(); setMode(currentMode); } });
      get('#studio-start').addEventListener('click', () => { studioGuideStep = 1; showStudioGuide('Step 1 of 2 · Add a class', 'Add a class to the member catalog. Then change Nina’s role to finish the partner scenario.', '#open-class-dialog'); });
      document.querySelectorAll<HTMLSelectElement>('[data-partner-role]').forEach((select) => select.addEventListener('change', () => { if (studioGuideStep !== 2 || select.dataset.partnerRole !== 'Nina Hsu') return; studioGuideStep = 0; showStudioGuide('Partner scenario complete', 'The class and staff permission change are visible in the shared workspace.', '#partner-role-status'); }));
      get('#admin-start').addEventListener('click', () => { selectedAdminMember = 'alex'; setAdminPanel('members'); renderAdmin(); adminGuideStep = 1; showStudioGuide('Step 1 of 1 · Support credit', 'Add one support credit for Alex. The member balance and activity record will update.', '#admin-credit-adjust'); });
      get('#admin-credit-adjust').addEventListener('click', () => { if (adminGuideStep !== 1) return; adminGuideStep = 0; showStudioGuide('Admin scenario complete', 'Alex’s directory balance and the activity record now reflect the support credit.', '#admin-activity'); });
      document.querySelectorAll<HTMLDialogElement>('#scenario-brief, #studio-brief, #admin-brief').forEach((brief) => brief.close());
      document.addEventListener('keydown', (event) => { if (event.key !== 'Escape') return; if (!dockPanel.hidden) { dockPanel.hidden = true; dockTab.setAttribute('aria-expanded', 'false'); dockTab.focus(); } if (!get<HTMLElement>('#tour-sheet').hidden) stopGuide(); if (!get<HTMLElement>('#studio-tour-sheet').hidden) stopStudioGuide(); });
    </script>
  </body>
</html>
