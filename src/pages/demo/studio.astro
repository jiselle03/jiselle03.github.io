        { id: 'tuesday-reformer', name: 'Reformer flow', category: 'pilates', format: 'Group', credits: 2, time: '6:45 PM', duration: '50 min', studio: 'Form House', instructor: 'Nina Hsu', level: 'All levels', capacity: '3 of 10 spots left', availability: 3, cancellation: 'Cancel 12 hours before class for all credits back.', description: 'A fuller reformer class with steady transitions and clear progressions.', weekday: 2 },
        { id: 'wednesday-kickboxing', name: 'Kickboxing conditioning', category: 'combat', format: 'Group', credits: 2, time: '7:15 PM', duration: '60 min', studio: 'Northside Gym', instructor: 'Leon Wu', level: 'All levels', capacity: '8 of 16 spots left', availability: 8, cancellation: 'Cancel 12 hours before class for all credits back.', description: 'Conditioning rounds, technique work, and controlled bag intervals.', weekday: 3 },
        { id: 'friday-strength', name: 'Friday barbell club', category: 'strength', format: 'Group', credits: 2, time: '6:30 PM', duration: '60 min', studio: 'Lift Lab', instructor: 'Sora Lin', level: 'All levels', capacity: '4 of 10 spots left', availability: 4, cancellation: 'Cancel 12 hours before class for all credits back.', description: 'A coached end-of-week lift with room to work at your own pace.', weekday: 5 },
        { id: 'saturday-bouldering', name: 'Bouldering practice', category: 'climbing', format: 'Group', credits: 2, time: '11:00 AM', duration: '75 min', studio: 'Stone Club', instructor: 'Mina Ko', level: 'All levels', capacity: '7 of 14 spots left', availability: 7, cancellation: 'Cancel 12 hours before class for all credits back.', description: 'A social practice session with route ideas and optional coaching cues.', weekday: 6 },
        { id: 'sunday-mobility', name: 'Sunday mobility', category: 'pilates', format: 'Group', credits: 2, time: '10:30 AM', duration: '45 min', studio: 'Form House', instructor: 'Nina Hsu', level: 'All levels', capacity: '6 of 12 spots left', availability: 6, cancellation: 'Cancel 12 hours before class for all credits back.', description: 'A calm reset for hips, shoulders, and the week ahead.', weekday: 0 },
      ];
      const initialSessions = sessions.map((session) => ({ ...session }));
      const studioDetails: Record<string, { location: string; arrival: string; included: string; access: string }> = {
        'Form House': { location: 'Da’an · 6 min from Zhongxiao Fuxing MRT', arrival: 'Check in at the front desk 10 minutes early.', included: 'Grip socks are available to borrow.', access: 'Lockers and showers are on site.' },
        'Northside Gym': { location: 'Songshan · 4 min from Nanjing Sanmin MRT', arrival: 'Check in upstairs 10 minutes before class.', included: 'Wraps and gloves are available to borrow.', access: 'Street-level entry; lockers are available.' },
        'Stone Club': { location: 'Xinyi · 5 min from Taipei 101/World Trade Center MRT', arrival: 'Meet your coach at the first-floor desk 10 minutes early.', included: 'Rental shoes are included for intro sessions.', access: 'Step-free entrance; lockers are available.' },
        'Lift Lab': { location: 'Zhongshan · 7 min from Shuanglian MRT', arrival: 'Arrive 10 minutes early for a bar setup and warm-up.', included: 'Chalk and equipment are included.', access: 'Lockers are available; ask staff for lift access.' },
      };
      const defaultEquipment: Record<ClassSession['category'], EquipmentItem[]> = {
        pilates: [{ label: 'Grip socks', note: 'Required on studio equipment.', kind: 'bring' }, { label: 'Water bottle', note: 'Refill station is on site.', kind: 'optional' }],
        combat: [{ label: 'Hand wraps', note: 'Bring your own or borrow a pair at check-in.', kind: 'bring' }, { label: 'Water bottle', note: 'Refill station is on site.', kind: 'optional' }],
        climbing: [{ label: 'Movement-ready clothes', note: 'Wear clothing you can move and fall in.', kind: 'bring' }, { label: 'Rental shoes', note: 'Included with this intro session.', kind: 'provided' }],
        strength: [{ label: 'Closed-toe training shoes', note: 'Required for barbell work.', kind: 'bring' }, { label: 'Water bottle', note: 'Refill station is on site.', kind: 'optional' }],
      };
      const equipmentFor = (session: ClassSession): EquipmentItem[] => session.equipment || defaultEquipment[session.category];
      const equipmentChecklist = (session: ClassSession, placement: 'detail' | 'schedule') => { const items = equipmentFor(session); return `<section class="sf-equipment-checklist sf-equipment-checklist--${placement}" aria-label="What to bring for ${session.name}"><p class="sf-kicker">Class readiness</p><h3>${placement === 'detail' ? 'What to bring' : 'Before you go'}</h3><ul>${items.map((item, index) => item.kind === 'provided' ? `<li class="is-provided"><span class="sf-readiness-mark" aria-hidden="true">✓</span><div><strong>${item.label}</strong><small>${item.note}</small></div><em class="sf-readiness-provided">Provided</em></li>` : `<li><span class="sf-readiness-mark" aria-hidden="true">${String(index + 1).padStart(2, '0')}</span><div><strong>${item.label}</strong><small>${item.note}</small></div><em class="sf-readiness-${item.kind}">${item.kind === 'bring' ? 'Required' : 'Optional'}</em></li>`).join('')}</ul></section>`; };
      let selectedId = 'bouldering'; let activeDay = 4; let categoryFilter = 'all'; let formatFilter = 'all'; let studioFilter = 'all'; let searchQuery = ''; let credits = 6; let bookingId = ''; let bookedCreditCost: number | null = null; let waitlistId = ''; let pendingWaitlistId = ''; let pendingBookingId = ''; let pendingStudioClass: ClassSession | null = null; let managedSessionId = ''; let mode = new URLSearchParams(window.location.search).get('role') === 'partner' ? 'studio' : new URLSearchParams(window.location.search).get('role') === 'admin' ? 'admin' : 'member'; let tourStep = 0; let studioGuideStep = 0; let adminGuideStep = 0; const cancelledBookings: { id: string; credits: number; reason: string }[] = [];
      const activity = ['Membership renewed: 6 credits added'];
      const savedStudios = new Set<string>();
      let reminderEnabled = false;
      const studioEnrollees: Record<string, string[]> = {
        reformer: ['Mara Lin', 'Joon Park', 'Iris Chen', 'Bo Wu', 'Nora Hsu', 'Kai Yeh'],
        bouldering: [],
        lagree: ['Aiko Chen', 'Mei Lin', 'Rina Wu', 'Tommy Hsu', 'Hana Chou', 'Bea Huang', 'Ivy Kao', 'Claire Lo', 'Jia Chen', 'May Lin'],
        kickboxing: ['Noah Yeh', 'Eli Chang', 'Yuki Chen', 'Zoe Liu', 'Leo Hsu', 'Mia Wang', 'Sam Wu', 'Yen Kao', 'Ari Lin', 'Ben Ho'],
        strength: ['Rae Ko', 'Zia Lin', 'Owen Chen', 'Mina Yeh', 'Tess Wu'],
      };
      const initialStudioEnrollees = Object.fromEntries(Object.entries(studioEnrollees).map(([id, members]) => [id, [...members]]));
      const sessionCapacity: Record<string, number> = { reformer: 10, lagree: 10, kickboxing: 16, bouldering: 1, strength: 8, 'monday-strength': 12, 'tuesday-reformer': 10, 'wednesday-kickboxing': 16, 'friday-strength': 10, 'saturday-bouldering': 14, 'sunday-mobility': 12 };
      const initialSessionCapacity = { ...sessionCapacity };
      const supportMembers = ['Aria Sun', 'Dae Kim', 'Elin Chou', 'Hugo Lin', 'Jules Kao', 'Miko Yeh'];
      let demoMemberName = 'Alex Park'; let demoMemberEmail = 'alex.park@example.com'; let paymentLastFour = '4821'; let accountMessage = ''; let guideTarget: HTMLElement | null = null; let studioGuideTarget: HTMLElement | null = null;
      const adminProfiles: Record<string, { name: string; membership: string; credits: number | null; booking: string; scope: string }> = { alex: { name: 'Alex Park', membership: 'Set weekly', credits: 6, booking: 'No active booking', scope: 'View, credit adjustment, booking support' }, mara: { name: 'Mara Lin', membership: 'Set monthly', credits: 12, booking: 'Reformer fundamentals · booked', scope: 'View, booking support' }, dae: { name: 'Dae Kim', membership: 'Set weekly · paused', credits: 0, booking: 'No active booking', scope: 'View only while membership is paused' }, jules: { name: 'Jules Kao', membership: 'Review pending', credits: null, booking: 'Not eligible until review is complete', scope: 'View, review notes' } }; const initialAdminProfiles = Object.fromEntries(Object.entries(adminProfiles).map(([id, profile]) => [id, { ...profile }])) as typeof adminProfiles; let selectedAdminMember = 'alex'; let adminOperatorContext = false;
      const get = <T extends HTMLElement>(selector: string) => { const element = document.querySelector<T>(selector); if (!element) throw new Error(`Missing ${selector}`); return element; };
      const announce = (message: string) => { get('#app-status').textContent = ''; window.requestAnimationFrame(() => { get('#app-status').textContent = message; }); };
      let lastDialogTrigger: HTMLElement | null = null;
      document.addEventListener('click', (event) => { const target = event.target as HTMLElement; if (target.closest('dialog')) return; const control = target.closest<HTMLElement>('button, a, input, select'); if (control) lastDialogTrigger = control; }, true);
      document.querySelectorAll<HTMLDialogElement>('dialog').forEach((dialog) => dialog.addEventListener('close', () => { const trigger = lastDialogTrigger; lastDialogTrigger = null; if (trigger && document.contains(trigger)) window.requestAnimationFrame(() => trigger.focus()); }));
      document.querySelectorAll<HTMLDialogElement>('dialog').forEach((dialog) => { if (dialog.querySelector('.sf-dialog-close')) return; const close = document.createElement('button'); close.type = 'button'; close.className = 'sf-dialog-close'; close.setAttribute('aria-label', 'Close dialog'); close.textContent = '×'; close.addEventListener('click', () => dialog.close()); dialog.append(close); });
      const sanitizeText = (value: string) => value.replace(/[<>&]/g, '').trim().slice(0, 64);
      const capacityFor = (session: ClassSession) => sessionCapacity[session.id] || session.availability;
      const enrolledFor = (id: string) => [...(studioEnrollees[id] || []), ...(bookingId === id ? [demoMemberName] : [])];
      const enrolledCount = (session: ClassSession) => enrolledFor(session.id).length;
      const availabilityText = (session: ClassSession) => session.availability === 0 ? 'Waitlist only' : capacityFor(session) === 1 ? '1 session available' : `${session.availability} of ${capacityFor(session)} spots left`;
      const timeToMinutes = (time: string) => { const twelveHour = time.match(/(\d{1,2}):(\d{2})\s*(AM|PM)/i); if (twelveHour) { const hour = Number(twelveHour[1]) % 12 + (twelveHour[3].toUpperCase() === 'PM' ? 12 : 0); return hour * 60 + Number(twelveHour[2]); } const twentyFourHour = time.match(/(\d{1,2}):(\d{2})/); return twentyFourHour ? Number(twentyFourHour[1]) * 60 + Number(twentyFourHour[2]) : 0; };
      const durationToMinutes = (duration: string) => Number.parseInt(duration, 10) || 0;
      const timeRange = (start: number, duration: number) => { const format = (value: number) => new Intl.DateTimeFormat('en', { hour: 'numeric', minute: '2-digit' }).format(new Date(`2026-09-18T${String(Math.floor(value / 60)).padStart(2, '0')}:${String(value % 60).padStart(2, '0')}:00`)); return `${format(start)}-${format(start + duration)}`; };
      const selected = () => sessions.find((session) => session.id === selectedId)!;
      const weekdayFor = (session: ClassSession) => session.weekday ?? 4;
      const dateForDay = (day: number) => { const date = new Date(); const daysUntilNextMonday = ((8 - date.getDay()) % 7) || 7; date.setDate(date.getDate() + daysUntilNextMonday + ((day + 6) % 7)); return date; };
      const dateLabel = (day: number) => new Intl.DateTimeFormat('en', { weekday: 'long', month: 'long', day: 'numeric' }).format(dateForDay(day));
      const sessionDateLabel = (session: ClassSession) => dateLabel(weekdayFor(session));
      const cancellationDeadlineFor = (session: ClassSession) => { const startsAt = dateForDay(weekdayFor(session)); const minutes = timeToMinutes(session.time); startsAt.setHours(Math.floor(minutes / 60), minutes % 60, 0, 0); const leadHours = /noon/i.test(session.cancellation) ? 8 : /Wednesday/i.test(session.cancellation) ? 24 : 12; return new Date(startsAt.getTime() - leadHours * 60 * 60 * 1000); };
      const refundEligible = (session: ClassSession) => Date.now() <= cancellationDeadlineFor(session).getTime();
      const availableSessions = () => { const query = searchQuery.toLowerCase(); return sessions.filter((session) => session.status !== 'cancelled' && weekdayFor(session) === activeDay && (categoryFilter === 'all' || session.category === categoryFilter) && (formatFilter === 'all' || session.format === formatFilter) && (studioFilter === 'all' || session.studio === studioFilter) && (!query || `${session.name} ${session.studio} ${session.instructor}`.toLowerCase().includes(query))); };
      const renderWeekPicker = () => { const weekDays = get<HTMLDivElement>('#week-days'); weekDays.replaceChildren(); [1, 2, 3, 4, 5, 6, 0].forEach((day) => { const date = dateForDay(day); const count = sessions.filter((session) => session.status !== 'cancelled' && weekdayFor(session) === day).length; const button = document.createElement('button'); button.type = 'button'; button.className = 'sf-week-day'; button.setAttribute('aria-pressed', String(day === activeDay)); button.innerHTML = `<span>${new Intl.DateTimeFormat('en', { weekday: 'short' }).format(date)}</span><strong>${date.getDate()}</strong><small>${count} ${count === 1 ? 'class' : 'classes'}</small>`; button.addEventListener('click', () => { activeDay = day; renderWeekPicker(); renderExplore(); }); weekDays.append(button); }); get('#day-stamp-weekday').textContent = new Intl.DateTimeFormat('en', { weekday: 'short' }).format(dateForDay(activeDay)); get('#day-stamp-date').textContent = String(dateForDay(activeDay).getDate()); get('#session-date').textContent = dateLabel(activeDay); };
      const resetFilters = () => { categoryFilter = 'all'; formatFilter = 'all'; studioFilter = 'all'; searchQuery = ''; get<HTMLFormElement>('#class-filters').reset(); renderExplore(); };
