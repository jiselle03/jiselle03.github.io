    <script>
      type EquipmentItem = { label: string; note: string; kind: 'bring' | 'optional' | 'provided' };
      type ClassSession = { id: string; name: string; category: 'pilates' | 'combat' | 'climbing' | 'strength'; format: 'Group' | '1:1'; credits: number; time: string; duration: string; studio: string; instructor: string; level: string; capacity: string; availability: number; cancellation: string; description: string; weekday?: number; status?: 'active' | 'cancelled'; equipment?: EquipmentItem[]; };
      const sessions: ClassSession[] = [
        { id: 'reformer', name: 'Reformer fundamentals', category: 'pilates', format: 'Group', credits: 2, time: '6:15 PM', duration: '50 min', studio: 'Form House', instructor: 'Nina Hsu', level: 'Beginner', capacity: '4 of 10 spots left', availability: 4, cancellation: 'Cancel by 6:15 PM Wednesday for all credits back.', description: 'A steady-paced introduction to spring resistance, form, and core control.' },
        { id: 'lagree', name: 'Lagree strength', category: 'pilates', format: 'Group', credits: 2, time: '7:30 PM', duration: '45 min', studio: 'Form House', instructor: 'Nina Hsu', level: 'All levels', capacity: 'Waitlist only', availability: 0, cancellation: 'Cancel by 7:30 PM Wednesday for all credits back.', description: 'Low-impact, high-intensity work on the Megaformer.' },
        { id: 'kickboxing', name: 'Technique kickboxing', category: 'combat', format: 'Group', credits: 2, time: '8:00 PM', duration: '60 min', studio: 'Northside Gym', instructor: 'Leon Wu', level: 'Beginner', capacity: '6 of 16 spots left', availability: 6, cancellation: 'Cancel by noon Thursday for all credits back.', description: 'Footwork, combinations, and bag work with a small group.' },
        { id: 'bouldering', name: '1:1 bouldering intro', category: 'climbing', format: '1:1', credits: 4, time: '7:00 PM', duration: '60 min', studio: 'Stone Club', instructor: 'Mina Ko', level: 'New to bouldering', capacity: '1 session available', availability: 1, cancellation: 'Cancel by 7:00 PM Wednesday for all 4 credits back.', description: 'A private first session covering movement, route reading, and safe falling.' },
