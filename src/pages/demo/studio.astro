---
import '../../styles/studio-clean.css';
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Set is a fictional frontend-only membership network for independent fitness studios, designed by Jiselle Liu." />
    <meta name="theme-color" content="#eef1f3" />
    <title>Set | Studio Membership Demo</title>
  </head>
  <body>
    <a class="sf-skip" href="#studio-main">Skip to main content</a>
    <div class="sf-demo-stage">
      <aside class="sf-demo-dock" aria-label="Demo controls">
        <button class="sf-demo-dock-tab" type="button" aria-expanded="false" aria-controls="demo-dock-panel">Demo<br />controls</button>
        <div id="demo-dock-panel" class="sf-demo-dock-panel" hidden>
          <button id="demo-dock-close" class="sf-demo-dock-close" type="button" aria-label="Minimize demo controls" title="Minimize demo controls">−</button>
          <p class="sf-demo-dock-label">Presentation layer</p>
          <strong>Set · fictional demo</strong>
          <span>Browser-only state resets on refresh.</span>
          <div class="sf-mode-switch" role="group" aria-label="Choose a demo workspace"><button type="button" data-mode="member" aria-pressed="true">Member</button><button type="button" data-mode="studio" aria-pressed="false">Partner</button><button type="button" data-mode="admin" aria-pressed="false">Admin</button></div>
          <button id="restart-demo-scenario" class="sf-shell-tour" type="button">Restart guided tour</button>
          <button id="open-build-notes" class="sf-shell-plan" type="button">How it scales</button>
          <a href="/" class="sf-demo-return">Return to portfolio</a>
        </div>
      </aside>
      <main id="studio-main" class="sf-app" tabindex="-1">
        <p id="app-status" class="sf-sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
        <header class="sf-product-bar"><a class="sf-product-wordmark" href="/demo/studio/"><span aria-hidden="true">S</span><strong>Set</strong><small>Membership network</small></a><p id="product-context" class="sf-network-index" hidden><span id="product-context-label" class="sf-network-label">Credits</span><strong id="product-context-value">06</strong><span id="product-context-copy">available</span></p></header>

        <header class="sf-header">
          <div class="sf-header-context"><p id="workspace-label" class="sf-workspace-label" hidden>UTC+8</p><div id="header-credit" class="sf-header-credit" aria-label="Available credits" hidden><strong id="header-credit-balance">6</strong><span>credits</span></div><button id="signed-in-identity" class="sf-signed-in-identity" type="button" aria-label="Open account for Alex Park" aria-controls="account-title"><span id="identity-initials" aria-hidden="true">AP</span><span class="sf-identity-copy"><strong id="identity-name">Alex Park</strong><small id="identity-role">Member · Set weekly</small></span></button></div>
        </header>
        <nav class="sf-member-nav" aria-label="Member workspace"><button type="button" data-view="explore" aria-current="page">Explore</button><button type="button" data-view="schedule">Schedule</button></nav>
        <nav id="admin-nav" class="sf-member-nav sf-admin-nav" aria-label="Admin workspace" hidden><button type="button" data-admin-panel-target="dashboard" aria-current="page">Overview</button><button type="button" data-admin-panel-target="members">Members</button><button type="button" data-admin-panel-target="partners">Partners</button><button type="button" data-admin-panel-target="support">Support</button><button type="button" data-admin-panel-target="roles">Roles</button></nav>

      <section class="sf-view" data-view-panel="explore">
        <section class="sf-member-home" aria-label="Member home"><div class="sf-home-top"><div><h1 id="member-home-title">Hey, Alex.</h1><p id="member-home-copy">Find a class that fits your week.</p></div><div class="sf-home-credit"><strong id="member-home-credits">4</strong><span>credits</span></div></div><article id="member-upcoming-card" class="sf-upcoming-card"><div class="sf-upcoming-content"><p class="sf-kicker">Next up</p><h2 id="member-upcoming-title">Kettlebell circuit</h2><p id="member-upcoming-meta">Monday · 7:00 PM · Lift Lab</p><button id="member-upcoming-action" class="sf-quiet-action" type="button">View schedule</button></div></article><div class="sf-category-heading"><h2>Explore</h2><button type="button" class="sf-text-action" data-home-filter="all">All classes</button></div><div class="sf-category-strip" aria-label="Browse by activity"><button type="button" data-home-filter="pilates">Pilates</button><button type="button" data-home-filter="combat">Combat</button><button type="button" data-home-filter="climbing">Climbing</button><button type="button" data-home-filter="strength">Strength</button></div></section>
        <div class="sf-desk-heading sf-desk-heading--member"><div class="sf-desk-date" aria-hidden="true"><span>Thu</span><strong>18</strong><small>Sep</small></div><div><h1 id="explore-title" tabindex="-1">Class board</h1></div></div>
        <form id="class-filters" class="sf-filter-bar" aria-label="Filter classes"><label class="sf-search-field">Search<input name="search" type="search" placeholder="Class, studio, or coach" autocomplete="off" /></label><label>Discipline<select name="category"><option value="all">All disciplines</option><option value="pilates">Pilates</option><option value="combat">Combat</option><option value="climbing">Climbing</option><option value="strength">Strength</option></select></label><label>Format<select name="format"><option value="all">All formats</option><option value="Group">Group class</option><option value="1:1">1:1 session</option></select></label><label>Studio<select name="studio"><option value="all">All studios</option><option value="Form House">Form House</option><option value="Northside Gym">Northside Gym</option><option value="Stone Club">Stone Club</option><option value="Lift Lab">Lift Lab</option></select></label><button id="clear-filters" class="sf-quiet-action" type="button">Clear filters</button></form>
        <section class="sf-week-nav" aria-label="Choose a day"><button id="previous-day" class="sf-week-arrow" type="button" aria-label="Previous day">‹</button><div id="week-days" class="sf-week-days"></div><button id="next-day" class="sf-week-arrow" type="button" aria-label="Next day">›</button></section>
        <div class="sf-explore-layout"><section><div class="sf-section-head"><div class="sf-day-stamp" aria-hidden="true"><span id="day-stamp-weekday">Today</span><strong id="day-stamp-date">--</strong></div><div><p class="sf-kicker">Available sessions</p><h2 id="session-date">This week</h2></div><span id="class-count"></span></div><p id="explore-status" class="sf-sr-only" role="status"></p><div class="sf-class-ledger-head" aria-hidden="true"><span>Time</span><span>Class record</span><span>Credits</span></div><div id="class-list" class="sf-class-list"></div></section><aside id="class-detail" class="sf-class-detail" aria-live="polite"></aside></div>
      </section>

      <section class="sf-view" data-view-panel="schedule" hidden>
        <div class="sf-desk-heading sf-desk-heading--member"><div class="sf-desk-date" aria-hidden="true"><span>Week</span><strong>SV</strong><small>Plan</small></div><div><h1 id="schedule-title" tabindex="-1">Schedule</h1></div></div>
        <div id="schedule-calendar" class="sf-calendar" aria-label="Weekly schedule"></div><div class="sf-schedule-layout"><section id="schedule-list" class="sf-schedule-list" aria-live="polite"></section></div><section class="sf-schedule-history" aria-labelledby="history-title"><div><p class="sf-kicker">Your history</p><h2 id="history-title">Past changes</h2></div><ol id="booking-history"></ol><button id="reminder-toggle" class="sf-quiet-action" type="button" aria-pressed="false">Turn on class reminders</button></section>
      </section>

      <section class="sf-view" data-view-panel="account" hidden>
        <div class="sf-desk-heading sf-desk-heading--member"><div><h1 id="account-title" tabindex="-1">Account</h1></div></div>
        <button id="account-return" class="sf-quiet-action sf-account-return" type="button">Back to Explore</button>
        <div id="member-account-content" class="sf-account-grid" data-account-content="member">
          <form id="profile-form" class="sf-account-panel"><p class="sf-kicker">Profile</p><h2>Your details</h2><p class="sf-demo-note">Fictional profile · edits stay in this tab and reset on refresh.</p><label>Full name<input id="account-name" name="name" autocomplete="name" required /></label><label>Email address<input id="account-email" name="email" type="email" autocomplete="email" required /></label><div class="sf-account-actions"><p id="account-status" role="status" aria-live="polite"></p><button class="sf-primary-action" type="submit">Save changes</button></div></form>
          <section class="sf-account-panel"><p class="sf-kicker">Membership</p><h2>Set weekly</h2><p class="sf-demo-note">Demo only · no real billing or notifications.</p><dl class="sf-account-list"><div><dt>Credits</dt><dd><strong id="account-credit-balance">6</strong> available</dd></div><div><dt>Renews</dt><dd>October 1</dd></div><div><dt>Payment</dt><dd id="payment-method">Visa ending in 4821</dd></div></dl><button id="open-payment-dialog" class="sf-quiet-action" type="button">View payment preview</button></section>
          <section class="sf-account-panel"><p class="sf-kicker">Preferences</p><h2>Settings</h2><label>Time zone<select aria-label="Time zone"><option>UTC+8 · Taipei</option><option>UTC+0 · London</option><option>UTC-5 · New York</option><option>UTC-8 · Los Angeles</option></select></label><button id="open-password-dialog" class="sf-quiet-action" type="button">Password settings preview</button></section>
          <section class="sf-account-panel sf-saved-studios"><p class="sf-kicker">Saved places</p><h2>Your studios</h2><button type="button" class="sf-quiet-action" data-save-studio="Form House">Save Form House <span>Da’an · 6 min from MRT</span></button><button type="button" class="sf-quiet-action" data-save-studio="Lift Lab">Save Lift Lab <span>Zhongshan · 7 min from MRT</span></button><p id="saved-studios-status" class="sf-account-status" role="status"></p></section>
        </div>
        <div class="sf-account-grid" data-account-content="studio" hidden><section class="sf-account-panel"><p class="sf-kicker">Partner account</p><h2>Jordan Lee</h2><p class="sf-demo-note">Fictional profile · changes are not saved to a service.</p><dl class="sf-account-list"><div><dt>Organization</dt><dd>Form House · Da’an</dd></div><div><dt>Role</dt><dd>Partner Admin</dd></div><div><dt>Access</dt><dd>Classes, roster, and Form House staff roles</dd></div></dl></section><section class="sf-account-panel"><p class="sf-kicker">Workspace</p><h2>Form House</h2><p class="sf-demo-note">Partner workspace · UTC+8</p><dl class="sf-account-list"><div><dt>Location</dt><dd>Da’an, Taipei</dd></div><div><dt>Demo state</dt><dd>Browser-only · resets on refresh</dd></div></dl></section></div>
        <div class="sf-account-grid" data-account-content="admin" hidden><section class="sf-account-panel"><p class="sf-kicker">Operations account</p><h2>Priya Shah</h2><p class="sf-demo-note">Fictional Set staff profile · no real account access.</p><dl class="sf-account-list"><div><dt>Organization</dt><dd>Set Operations</dd></div><div><dt>Role</dt><dd>Platform Admin</dd></div><div><dt>Access</dt><dd>Member support, partner review, and platform roles</dd></div></dl></section><section class="sf-account-panel"><p class="sf-kicker">Workspace</p><h2>Set Operations</h2><p class="sf-demo-note">Operations workspace · UTC+8</p><dl class="sf-account-list"><div><dt>Data</dt><dd>Fictional demo records only</dd></div><div><dt>Demo state</dt><dd>Browser-only · resets on refresh</dd></div></dl></section></div>
        <section class="sf-account-panel sf-account-preferences"><p class="sf-kicker">Appearance</p><h2>Preferences</h2><p class="sf-demo-note">This setting only changes the demo in your browser tab.</p><button id="theme-toggle-account" class="sf-quiet-action" type="button" aria-pressed="false">Dark theme</button></section>
      </section>

      <section class="sf-view" data-view-panel="studio" hidden>
        <div class="sf-desk-heading sf-desk-heading--partner"><div class="sf-desk-date" aria-hidden="true"><span>Form</span><strong>FH</strong><small>Da’an</small></div><div><h1 id="studio-title" tabindex="-1">Class roster</h1></div><div class="sf-studio-actions"><button id="open-class-dialog" class="sf-primary-action" type="button">Add class record</button></div></div>
        <p id="studio-summary" class="sf-studio-summary" role="status"></p>
        <div class="sf-studio-grid"><section class="sf-studio-panel"><p class="sf-kicker">Partner studios</p><h2>This week’s roster</h2><div class="sf-roster-ledger-head" aria-hidden="true"><span>Class record</span><span>Seats / action</span></div><div id="studio-roster" class="sf-roster"></div></section><section class="sf-studio-panel"><p class="sf-kicker">Recent activity</p><ol id="activity-list" class="sf-activity"></ol></section></div>
        <section class="sf-role-register" aria-labelledby="partner-role-title"><div><p class="sf-kicker">Form House organization</p><h2 id="partner-role-title">Staff &amp; roles register</h2><p>Jordan is the Partner Admin. Change a staff role to demonstrate the organization-scoped permission model.</p><p id="partner-role-status" class="sf-register-status" role="status"></p></div><div class="sf-register-table" role="region" aria-label="Form House staff permissions" tabindex="0"><div class="sf-register-row sf-register-head"><span>Account</span><span>Role</span><span>Scope</span><span>Can edit</span></div><div class="sf-register-row"><strong>Jordan Lee</strong><span>Partner Admin</span><span>All Form House</span><span>Classes, roster, staff roles</span></div><div class="sf-register-row"><strong>Nina Hsu</strong><label class="sf-role-select"><span class="sf-sr-only">Nina Hsu role</span><select data-partner-role="Nina Hsu"><option>Trainer</option><option>Front Desk</option></select></label><span>Da’an</span><span id="partner-permission-nina">Attendance only</span></div><div class="sf-register-row"><strong>Yara Chen</strong><label class="sf-role-select"><span class="sf-sr-only">Yara Chen role</span><select data-partner-role="Yara Chen"><option>Front Desk</option><option>Trainer</option></select></label><span>Da’an</span><span id="partner-permission-yara">Check-in, roster notes</span></div></div></section>
      </section>

      <section class="sf-view" data-view-panel="admin" hidden>
        <div class="sf-desk-heading sf-desk-heading--admin"><div class="sf-desk-date" aria-hidden="true"><span>Set</span><strong>OP</strong><small>Desk</small></div><div><h1 id="admin-title" tabindex="-1">Overview</h1></div></div>
        <section id="admin-dashboard-panel" class="sf-admin-panel" aria-label="Platform overview"><div class="sf-admin-overview-head"><p class="sf-kicker">Platform overview</p><label>Range<select id="admin-range"><option value="30">Last 30 days</option><option value="90">Last 90 days</option></select></label></div><div class="sf-admin-stat-grid"><article><span>Active members</span><strong id="admin-stat-members">1,284</strong><small>+8.4%</small></article><article><span>Partner studios</span><strong id="admin-stat-partners">42</strong><small>3 pending review</small></article><article><span>Bookings</span><strong id="admin-stat-bookings">8,420</strong><small>91% attended</small></article><article><span>Support queue</span><strong id="admin-stat-support">18</strong><small>5 need review</small></article></div><div class="sf-admin-chart-grid"><article><div><p class="sf-kicker">Bookings</p><strong>8,420</strong><small>Last 30 days</small></div><div class="sf-bar-chart" role="img" aria-label="Bookings rose from 420 to 780 per week"><i style="height:32%"></i><i style="height:48%"></i><i style="height:42%"></i><i style="height:65%"></i><i style="height:58%"></i><i style="height:78%"></i><i style="height:92%"></i></div></article><article><div><p class="sf-kicker">Attendance</p><strong>91%</strong><small>Across all partners</small></div><div class="sf-line-chart" role="img" aria-label="Attendance rose from 84 percent to 91 percent over the selected range"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div></article></div></section>
        <section id="admin-directory-panel" class="sf-admin-panel" aria-label="Directories" hidden><div class="sf-admin-grid"><section class="sf-admin-directory"><div class="sf-admin-tabs" role="tablist" aria-label="Directory type"><button id="admin-members-tab" type="button" role="tab" aria-selected="true">Members</button><button id="admin-partners-tab" type="button" role="tab" aria-selected="false">Partners</button></div><div id="admin-member-directory" role="tabpanel"><p class="sf-kicker">Members · 04 shown</p><button type="button" class="is-selected" data-admin-member="alex"><strong>Alex Park</strong><span>Active · Set weekly</span></button><button type="button" data-admin-member="mara"><strong>Mara Lin</strong><span>Active · Set monthly</span></button><button type="button" data-admin-member="dae"><strong>Dae Kim</strong><span>Paused · Set weekly</span></button><button type="button" data-admin-member="jules"><strong>Jules Kao</strong><span>Pending review</span></button></div><div id="admin-partner-directory" role="tabpanel" hidden><p class="sf-kicker">Partners · 04 shown</p><div class="sf-directory-entry"><span><strong>Form House</strong><small>Active · 4 staff · 12 classes</small></span><button type="button" class="sf-directory-toggle" data-partner-toggle="form">Disable</button></div><div class="sf-directory-entry"><span><strong>Northside Gym</strong><small>Active · 7 staff · 18 classes</small></span><button type="button" class="sf-directory-toggle" data-partner-toggle="northside">Disable</button></div><div class="sf-directory-entry"><span><strong>Stone Club</strong><small>Review due · 3 staff · 8 classes</small></span><button type="button" class="sf-directory-toggle" data-partner-toggle="stone">Disable</button></div><div class="sf-directory-entry"><span><strong>Lift Lab</strong><small>Active · 5 staff · 10 classes</small></span><button type="button" class="sf-directory-toggle" data-partner-toggle="lift">Disable</button></div></div></section><section class="sf-admin-record"><p class="sf-kicker">Selected account</p><h2 id="admin-member-name">Alex Park</h2><dl><div><dt>Membership</dt><dd id="admin-membership">Set weekly · 6 credits</dd></div><div><dt>Current booking</dt><dd id="admin-booking-status">No active booking</dd></div><div><dt>Support scope</dt><dd id="admin-support-scope">View, credit adjustment, booking support</dd></div></dl><button id="admin-credit-adjust" class="sf-primary-action" type="button">Add 1 support credit</button><button id="admin-toggle-status" class="sf-quiet-action" type="button">Disable member</button><p id="admin-support-status" class="sf-admin-status" role="status"></p></section><aside class="sf-admin-history"><p class="sf-kicker">Activity</p><ol id="admin-activity"><li><strong>09:41</strong><span>Directory opened by Priya Shah</span></li><li><strong>09:38</strong><span>Membership record verified</span></li><li><strong>Yesterday</strong><span>Credit renewal posted</span></li></ol></aside></div></section>
        <section id="admin-roles-panel" class="sf-admin-panel" aria-labelledby="platform-role-title" hidden><div class="sf-role-register"><div><p class="sf-kicker">Access control</p><h2 id="platform-role-title">Roles &amp; permissions</h2></div><div class="sf-register-table" role="region" aria-label="Set platform permissions" tabindex="0"><div class="sf-register-row sf-register-head"><span>Role</span><span>Directory</span><span>Support actions</span><span>Role management</span></div><div class="sf-register-row"><strong>Admin</strong><span>View + edit</span><span>Approved</span><span>Manage roles</span></div><div class="sf-register-row"><strong>Operator</strong><span>View</span><span>Credit and booking support</span><span>Not permitted</span></div></div></div></section>
      </section>
      <section id="admin-support-panel" class="sf-admin-panel sf-admin-support-panel" aria-label="Support queue" hidden><div class="sf-admin-support-head"><div><p class="sf-kicker">Support queue</p><h2>Cases needing review</h2></div><label>Role<select id="admin-role-context"><option>Admin</option><option>Operator</option></select></label></div><div class="sf-support-layout"><div class="sf-support-queue"><button type="button" class="is-current" data-support-case="credit"><strong>Credit adjustment</strong><span>Alex Park · 2 min ago</span></button><button type="button" data-support-case="booking"><strong>Booking dispute</strong><span>Mara Lin · 18 min ago</span></button><button type="button" data-support-case="partner"><strong>Partner review</strong><span>Stone Club · Today</span></button></div><article class="sf-support-record"><p class="sf-kicker">Selected case</p><h3 id="support-case-title">Credit adjustment</h3><p id="support-case-copy">Alex requested a review of a missing credit after a cancelled class.</p><dl><div><dt>Owner</dt><dd id="support-case-owner">Priya Shah</dd></div><div><dt>State</dt><dd id="support-case-state">In review</dd></div></dl><button id="support-resolve" class="sf-primary-action" type="button">Resolve case</button><p id="support-case-status" class="sf-admin-status" role="status"></p></article></div></section>

      </main>
    </div>

    <dialog id="scenario-brief" class="sf-dialog" aria-labelledby="scenario-title" aria-describedby="scenario-copy"><div><p class="sf-kicker">Member · Alex Park</p><h2 id="scenario-title">Thursday plans change.</h2><p id="scenario-copy" class="sf-dialog-copy">Use 6 credits to book a private session, cancel in time, then choose a group class.</p><ol><li><span>Book</span><strong>1:1 bouldering · 4 credits</strong></li><li><span>Cancel</span><strong>Get the credits back before the cutoff</strong></li><li><span>Rebook</span><strong>Choose a 2-credit group class</strong></li></ol><div class="sf-dialog-actions sf-scenario-actions"><button id="scenario-explore" class="sf-quiet-action" type="button">Explore freely</button><button id="scenario-start" class="sf-primary-action" type="button">Follow the steps</button></div></div></dialog>
    <dialog id="booking-dialog" class="sf-dialog sf-confirm-dialog" aria-labelledby="booking-title"><div><p class="sf-kicker">Confirm booking</p><h2 id="booking-title">Book this class?</h2><p id="booking-copy"></p><div class="sf-dialog-actions"><button id="booking-cancel" class="sf-quiet-action" type="button">Keep exploring</button><button id="booking-confirm" class="sf-primary-action" type="button">Confirm booking</button></div></div></dialog>
    <dialog id="cancellation-dialog" class="sf-dialog sf-confirm-dialog" aria-labelledby="cancellation-title"><div><p class="sf-kicker">Confirm cancellation</p><h2 id="cancellation-title">Cancel this class?</h2><p id="cancellation-copy"></p><div class="sf-dialog-actions"><button id="cancellation-dismiss" class="sf-quiet-action" type="button">Keep this class</button><button id="cancellation-confirm" class="sf-primary-action" type="button">Cancel class</button></div></div></dialog>
    <dialog id="waitlist-dialog" class="sf-dialog sf-waitlist-dialog" aria-labelledby="waitlist-title"><div><p class="sf-kicker">Join the waitlist</p><h2 id="waitlist-title">Join this class?</h2><p id="waitlist-copy">If a space opens, you will be automatically enrolled and your credits will be used.</p><div class="sf-dialog-actions"><button id="waitlist-cancel" class="sf-quiet-action" type="button">Not now</button><button id="waitlist-confirm" class="sf-primary-action" type="button">Join waitlist</button></div></div></dialog>
    <dialog id="studio-brief" class="sf-dialog" aria-labelledby="studio-brief-title" aria-describedby="studio-brief-copy"><div><p class="sf-kicker">Partner · Jordan Lee</p><h2 id="studio-brief-title">Put a class on the roster.</h2><p id="studio-brief-copy" class="sf-dialog-copy">Add a session, check its seats, then adjust a staff role.</p><div class="sf-dialog-actions sf-scenario-actions"><button id="studio-explore" class="sf-quiet-action" type="button">Explore freely</button><button id="studio-start" class="sf-primary-action" type="button">Follow the steps</button></div></div></dialog>
    <dialog id="admin-brief" class="sf-dialog" aria-labelledby="admin-brief-title" aria-describedby="admin-brief-copy"><div><p class="sf-kicker">Set operations · Priya Shah</p><h2 id="admin-brief-title">Review a credit request.</h2><p id="admin-brief-copy" class="sf-dialog-copy">Find Alex, add one support credit, and check the activity record.</p><div class="sf-dialog-actions sf-scenario-actions"><button id="admin-explore" class="sf-quiet-action" type="button">Explore freely</button><button id="admin-start" class="sf-primary-action" type="button">Follow the steps</button></div></div></dialog>
