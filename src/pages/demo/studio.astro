---
import '../../styles/studio.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Set is a fictional frontend-only fitness class booking product concept by Jiselle Liu." />
    <meta name="theme-color" content="#17223e" />
    <title>Set | Independent Product Demo</title>
  </head>
  <body>
    <a class="sf-skip" href="#studio-main">Skip to main content</a>
    <main id="studio-main" class="sf-app" tabindex="-1">
      <header class="sf-header">
        <a class="sf-brand" href="/demo/studio/"><span aria-hidden="true">S</span> Set</a>
        <nav aria-label="Set views"><button type="button" data-view="explore" aria-current="page">Explore</button><button type="button" data-view="schedule">My schedule</button><button type="button" data-view="studio">Studio view</button></nav>
        <div class="sf-credit-balance"><span>Available</span><strong id="credit-balance">6</strong><small>credits</small></div>
      </header>

      <section class="sf-view" data-view-panel="explore">
        <div class="sf-page-heading"><div><p class="sf-kicker">This week in Taipei</p><h1>Make time for a class.</h1><p>Use credits for group classes and 1:1 sessions at independent studios.</p></div><button id="restart-scenario" class="sf-quiet-action" type="button">Restart scenario</button></div>
        <div class="sf-filter-row" aria-label="Filter classes by format"><button type="button" data-filter="all" aria-pressed="true">All classes</button><button type="button" data-filter="pilates" aria-pressed="false">Pilates</button><button type="button" data-filter="combat" aria-pressed="false">Combat</button><button type="button" data-filter="climbing" aria-pressed="false">Climbing</button><button type="button" data-filter="strength" aria-pressed="false">Strength</button></div>
        <div class="sf-explore-layout"><section><div class="sf-section-head"><div><p class="sf-kicker">Available sessions</p><h2>Thursday, September 18</h2></div><span id="class-count"></span></div><div id="class-list" class="sf-class-list"></div></section><aside id="class-detail" class="sf-class-detail" aria-live="polite"></aside></div>
      </section>

      <section class="sf-view" data-view-panel="schedule" hidden>
        <div class="sf-page-heading"><div><p class="sf-kicker">Your bookings</p><h1>My schedule</h1><p>Everything you have booked, joined, or changed in one place.</p></div></div>
        <div class="sf-schedule-layout"><section id="schedule-list" class="sf-schedule-list"></section><aside class="sf-credit-card"><p class="sf-kicker">Credit balance</p><strong id="schedule-credit-balance">6</strong><span>credits ready to book</span><hr /><p id="credit-note">Your membership renews October 1.</p></aside></div>
      </section>

      <section class="sf-view" data-view-panel="studio" hidden>
        <div class="sf-page-heading"><div><p class="sf-kicker">Studio operations</p><h1>Form House</h1><p>A compact view for the studio team. It shares the same local booking state as the member experience.</p></div></div>
        <div class="sf-studio-grid"><section class="sf-studio-panel"><p class="sf-kicker">Today</p><h2>Class roster</h2><div id="studio-roster" class="sf-roster"></div></section><section class="sf-studio-panel"><p class="sf-kicker">Member changes</p><h2>Recent activity</h2><ol id="activity-list" class="sf-activity"></ol></section></div>
      </section>

      <footer>Fictional frontend demo by <a href="/">Jiselle Liu</a>.</footer>
    </main>

    <dialog id="scenario-brief" class="sf-dialog" aria-labelledby="scenario-title"><div><p class="sf-kicker">A working scenario</p><h2 id="scenario-title">Your plans change. Your credits should keep up.</h2><ol><li><span>Starting point</span><strong>You have 6 credits and Thursday evening free.</strong></li><li><span>First booking</span><strong>Book a 1:1 bouldering session for 4 credits.</strong></li><li><span>Change of plans</span><strong>Cancel in time, receive the credits back, then book a 2-credit group class.</strong></li></ol><div class="sf-dialog-actions"><button id="scenario-explore" class="sf-quiet-action" type="button">Explore on my own</button><button id="scenario-start" class="sf-primary-action" type="button">Start guided scenario</button></div></div></dialog>
    <aside id="tour-sheet" class="sf-tour-sheet" aria-live="polite" hidden><p id="tour-step" class="sf-kicker"></p><strong id="tour-title"></strong><p id="tour-copy"></p><button id="tour-dismiss" type="button">Dismiss guide</button></aside>

    <script>
      type ClassSession = { id: string; name: string; category: 'pilates' | 'combat' | 'climbing' | 'strength'; format: 'Group' | '1:1'; credits: number; time: string; duration: string; studio: string; instructor: string; level: string; capacity: string; availability: number; cancellation: string; description: string; };
      const sessions: ClassSession[] = [
        { id: 'reformer', name: 'Reformer fundamentals', category: 'pilates', format: 'Group', credits: 2, time: '6:15 PM', duration: '50 min', studio: 'Form House', instructor: 'Nina Hsu', level: 'Beginner', capacity: '4 of 10 spots left', availability: 4, cancellation: 'Cancel by 6:15 PM Wednesday for all credits back.', description: 'A steady-paced introduction to spring resistance, form, and core control.' },
        { id: 'lagree', name: 'Lagree strength', category: 'pilates', format: 'Group', credits: 2, time: '7:30 PM', duration: '45 min', studio: 'Form House', instructor: 'Nina Hsu', level: 'All levels', capacity: 'Waitlist only', availability: 0, cancellation: 'Cancel by 7:30 PM Wednesday for all credits back.', description: 'Low-impact, high-intensity work on the Megaformer.' },
        { id: 'kickboxing', name: 'Technique kickboxing', category: 'combat', format: 'Group', credits: 2, time: '8:00 PM', duration: '60 min', studio: 'Northside Gym', instructor: 'Leon Wu', level: 'Beginner', capacity: '6 of 16 spots left', availability: 6, cancellation: 'Cancel by noon Thursday for all credits back.', description: 'Footwork, combinations, and bag work with a small group.' },
        { id: 'bouldering', name: '1:1 bouldering intro', category: 'climbing', format: '1:1', credits: 4, time: '7:00 PM', duration: '60 min', studio: 'Stone Club', instructor: 'Mina Ko', level: 'New to bouldering', capacity: '1 session available', availability: 1, cancellation: 'Cancel by 7:00 PM Wednesday for all 4 credits back.', description: 'A private first session covering movement, route reading, and safe falling.' },
        { id: 'strength', name: 'Barbell basics', category: 'strength', format: 'Group', credits: 2, time: '6:30 PM', duration: '60 min', studio: 'Lift Lab', instructor: 'Sora Lin', level: 'Beginner', capacity: '3 of 8 spots left', availability: 3, cancellation: 'Cancel by 6:30 PM Wednesday for all credits back.', description: 'Learn the squat, hinge, press, and pull with coaching and space to practice.' },
      ];
      let selectedId = 'bouldering'; let filter = 'all'; let credits = 6; let bookingId = ''; let waitlisted = false; let tourStep = 0;
      const activity = ['Membership renewed: 6 credits added'];
      const get = <T extends HTMLElement>(selector: string) => { const element = document.querySelector<T>(selector); if (!element) throw new Error(`Missing ${selector}`); return element; };
      const selected = () => sessions.find((session) => session.id === selectedId)!;
      const availableSessions = () => sessions.filter((session) => filter === 'all' || session.category === filter);
      const setView = (view: string, focus = false) => { document.querySelectorAll<HTMLElement>('[data-view-panel]').forEach((panel) => { panel.hidden = panel.dataset.viewPanel !== view; }); document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((button) => { if (button.dataset.view === view) button.setAttribute('aria-current', 'page'); else button.removeAttribute('aria-current'); }); if (focus) get('#studio-main').focus(); };
      const updateCredits = () => { get('#credit-balance').textContent = String(credits); get('#schedule-credit-balance').textContent = String(credits); };
      const showGuide = (step: number, title: string, copy: string) => { tourStep = step; get('#tour-step').textContent = `Guided scenario · ${step} of 3`; get('#tour-title').textContent = title; get('#tour-copy').textContent = copy; get('#tour-sheet').hidden = false; };
      const stopGuide = () => { tourStep = 0; get('#tour-sheet').hidden = true; };
      const renderExplore = () => { const list = get<HTMLDivElement>('#class-list'); const detail = get<HTMLDivElement>('#class-detail'); const items = availableSessions(); get('#class-count').textContent = `${items.length} sessions`; list.replaceChildren(); items.forEach((session) => { const card = document.createElement('button'); card.type = 'button'; card.className = `sf-class-card${session.id === selectedId ? ' is-selected' : ''}`; card.innerHTML = `<span class="sf-class-time">${session.time}</span><span><small>${session.format} · ${session.level}</small><strong>${session.name}</strong><em>${session.studio} · ${session.instructor}</em></span><b>${session.credits} credits</b>`; card.addEventListener('click', () => { selectedId = session.id; renderExplore(); }); list.append(card); }); const session = selected(); const isBooked = bookingId === session.id; const canBook = !bookingId && credits >= session.credits && session.availability > 0; detail.innerHTML = `<p class="sf-kicker">${session.format} · ${session.level}</p><h2>${session.name}</h2><p>${session.description}</p><dl><div><dt>When</dt><dd>Thursday · ${session.time}<br />${session.duration}</dd></div><div><dt>Where</dt><dd>${session.studio}<br />with ${session.instructor}</dd></div><div><dt>Availability</dt><dd>${session.capacity}</dd></div><div><dt>Cancellation</dt><dd>${session.cancellation}</dd></div></dl><div class="sf-detail-actions"><span><strong>${session.credits}</strong> credits</span>${session.availability === 0 ? `<button id="waitlist-button" class="sf-quiet-action" type="button">${waitlisted ? 'On waitlist' : 'Join waitlist'}</button>` : `<button id="booking-button" class="sf-primary-action" type="button" ${canBook ? '' : 'disabled'}>${isBooked ? 'Booked' : credits < session.credits ? 'Not enough credits' : bookingId ? 'Another class booked' : 'Book class'}</button>`}</div>`; const bookingButton = document.querySelector<HTMLButtonElement>('#booking-button'); bookingButton?.addEventListener('click', () => book(session)); get<HTMLButtonElement>('#waitlist-button')?.addEventListener('click', () => { waitlisted = true; activity.unshift(`Joined the waitlist for ${session.name}`); renderExplore(); renderStudio(); }); };
      const renderSchedule = () => { const list = get<HTMLDivElement>('#schedule-list'); list.replaceChildren(); if (!bookingId) list.innerHTML = '<div class="sf-empty"><strong>No bookings yet.</strong><p>Choose a class from Explore to build your week.</p><button id="empty-explore" class="sf-primary-action" type="button">Explore classes</button></div>'; else { const session = sessions.find((item) => item.id === bookingId)!; list.innerHTML = `<article class="sf-booking"><div><p class="sf-kicker">Thursday, September 18</p><h2>${session.name}</h2><p>${session.time} · ${session.duration}<br />${session.studio} with ${session.instructor}</p></div><div><span class="sf-booking-status">Booked</span><strong>${session.credits} credits used</strong></div><div class="sf-booking-policy"><strong>Eligible for a credit refund</strong><span>${session.cancellation}</span></div><button id="cancel-booking" class="sf-quiet-action" type="button">Cancel and return credits</button></article>`; get<HTMLButtonElement>('#cancel-booking').addEventListener('click', cancelBooking); } get<HTMLButtonElement>('#empty-explore')?.addEventListener('click', () => setView('explore', true)); get('#credit-note').textContent = bookingId ? 'Your booked class is held with credits, not a real payment.' : 'Your membership renews October 1.'; };
      const renderStudio = () => { const roster = get<HTMLDivElement>('#studio-roster'); roster.innerHTML = `<article><span>1:1 bouldering intro</span><strong>${bookingId === 'bouldering' ? '1 of 1 booked' : '1 of 1 available'}</strong><small>Mina Ko · 7:00 PM</small></article><article><span>Lagree strength</span><strong>${waitlisted ? '10 booked · 1 waitlisted' : '10 of 10 booked'}</strong><small>Nina Hsu · 7:30 PM</small></article><article><span>Technique kickboxing</span><strong>${bookingId === 'kickboxing' ? '11 of 16 booked' : '10 of 16 booked'}</strong><small>Leon Wu · 8:00 PM</small></article>`; const activityList = get<HTMLOListElement>('#activity-list'); activityList.replaceChildren(); activity.forEach((entry) => { const item = document.createElement('li'); item.textContent = entry; activityList.append(item); }); };
      const render = () => { updateCredits(); renderExplore(); renderSchedule(); renderStudio(); };
      const book = (session: ClassSession) => { if (bookingId || credits < session.credits || session.availability === 0) return; bookingId = session.id; credits -= session.credits; activity.unshift(`Booked ${session.name} using ${session.credits} credits`); render(); setView('schedule'); if (tourStep === 1 && session.id === 'bouldering') showGuide(2, 'Your booking is confirmed', 'Open the cancellation option to see how a timely change returns all 4 credits.'); if (tourStep === 3 && session.id === 'kickboxing') showGuide(3, 'Scenario complete', 'You used 2 credits for a group class. Your schedule, balance, and the studio roster now agree.'); };
      const cancelBooking = () => { if (!bookingId) return; const session = sessions.find((item) => item.id === bookingId)!; credits += session.credits; activity.unshift(`Cancelled ${session.name}; ${session.credits} credits returned`); bookingId = ''; render(); if (tourStep === 2) { selectedId = 'kickboxing'; setView('explore'); render(); showGuide(3, 'Pick a group class instead', 'Book Technique kickboxing for 2 credits. Your available balance and studio roster will update together.'); } };
      const resetScenario = () => { credits = 6; bookingId = ''; waitlisted = false; selectedId = 'bouldering'; filter = 'all'; activity.splice(0, activity.length, 'Membership renewed: 6 credits added'); document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === 'all'))); render(); setView('explore'); showGuide(1, 'Start with the 1:1 session', 'Open 1:1 bouldering intro and book it for 4 credits. The class detail explains the cancellation rule before you commit.'); };
      document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((button) => button.addEventListener('click', () => setView(button.dataset.view || 'explore', true))); document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => button.addEventListener('click', () => { filter = button.dataset.filter || 'all'; document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((item) => item.setAttribute('aria-pressed', String(item === button))); const first = availableSessions()[0]; if (first) selectedId = first.id; renderExplore(); })); get('#restart-scenario').addEventListener('click', resetScenario); get('#tour-dismiss').addEventListener('click', stopGuide); get('#scenario-start').addEventListener('click', () => { try { sessionStorage.setItem('set-scenario-seen', 'true'); } catch {} get<HTMLDialogElement>('#scenario-brief').close(); resetScenario(); }); get('#scenario-explore').addEventListener('click', () => { try { sessionStorage.setItem('set-scenario-seen', 'true'); } catch {} get<HTMLDialogElement>('#scenario-brief').close(); }); render(); try { if (!sessionStorage.getItem('set-scenario-seen')) window.setTimeout(() => get<HTMLDialogElement>('#scenario-brief').showModal(), 250); } catch { window.setTimeout(() => get<HTMLDialogElement>('#scenario-brief').showModal(), 250); }
    </script>
  </body>
</html>
