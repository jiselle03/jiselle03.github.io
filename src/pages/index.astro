---
import '../styles/global.css';

const links = [
  { label: 'GitHub', href: 'https://github.com/jiselle03' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/jiselleliu' },
  { label: 'Writing', href: 'https://www.timidmag.com/writers/jiselle-liu' },
  { label: 'Email', href: 'mailto:hello@jiselleliu.com' },
];

const signals = [
  { label: 'Tutoring Platform', value: 'Scheduling, attendance, learning resources' },
  { label: 'AI Hiring Platform', value: 'Candidate workflows and decision support' },
  { label: 'Fitness Tracker', value: 'Hum: calm progress loops for training and recovery' },
];

const ownershipNotes = [
  { label: 'Product development', value: 'Owned product direction and shipped the build' },
  { label: 'Forward engineering', value: 'Streamlining company workflows with pragmatic AI' },
];

const earlierWork = ['Freight payments, lending, and e-commerce tools', 'XR commerce experiences'];

const preferredStack = ['TypeScript', 'Next.js', 'React', 'tRPC', 'Drizzle', 'PostgreSQL', 'Tailwind', 'OpenAI', 'Vitest'];
const additionalExperience = ['Vue', 'Ruby on Rails', 'Go', 'Express', 'MongoDB', 'React Query', 'Playwright', 'Claude Code', 'Codex'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Jiselle Liu, fullstack engineer building useful software and careful interfaces." />
    <meta name="theme-color" content="#0b1d2a" />
    <link rel="icon" href="/icons/favicon_512.png" />
    <link rel="apple-touch-icon" href="/icons/favicon_512.png" />
    <link rel="manifest" href="/manifest.json" />
    <title>Jiselle Liu | Fullstack Engineer</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" aria-label="Site header">
      <a class="brand" href="/" aria-label="Jiselle Liu home">
        <span class="brand-mark" aria-hidden="true">JL</span>
        <span>Jiselle Liu</span>
      </a>

      <nav class="nav-links" aria-label="Primary navigation">
        {links.map((link) => (
          <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noreferrer' : undefined}>
            {link.label}
          </a>
        ))}
      </nav>
    </header>

    <main id="main" class="page-shell">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Fullstack engineer / product-minded builder</p>
          <h1 id="hero-title">
            <span>Useful software,</span>
            <span>careful interfaces.</span>
          </h1>
          <p class="lede">
            I build across the stack with close attention to the product surface:
            the flows, states, copy, and interaction details that shape user experience.
          </p>

          <div class="hero-actions" aria-label="Primary links">
            <a class="button button-primary" href="mailto:hello@jiselleliu.com">Contact</a>
            <a class="button button-secondary" href="https://github.com/jiselle03" target="_blank" rel="noreferrer">GitHub</a>
          </div>
        </div>

        <div class="interface-board" aria-hidden="true">
          <div class="board-window window-a">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="board-window window-b">
            <span></span>
            <span></span>
          </div>
          <div class="board-cursor"></div>
        </div>
      </section>

      <section class="work-section" aria-labelledby="work-title">
        <div class="section-kicker">
          <h2 id="work-title">Recent work</h2>
        </div>

        <div class="ownership-strip" aria-label="Work style">
          {ownershipNotes.map((item) => (
            <p>
              <span>{item.label}</span>
              {item.value}
            </p>
          ))}
        </div>

        <div class="signal-grid">
          {signals.map((item) => (
            <article class="signal-card">
              <p>{item.label}</p>
              <h3>{item.value}</h3>
            </article>
          ))}
        </div>

        <div class="earlier-work" aria-label="Earlier work">
          <p>Earlier work</p>
          <ul>
            {earlierWork.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </section>

      <section class="stack-band" aria-label="Technology stack">
        <div>
          <p>Preferred stack</p>
          <ul>
            {preferredStack.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>

        <div>
          <p>Additional experience</p>
          <ul>
            {additionalExperience.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </section>
    </main>
  </body>
</html>
