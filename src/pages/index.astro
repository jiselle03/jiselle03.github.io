---
import '../styles/global.css';

const links = [
  { label: 'Demo', href: '/demo/vendor-readiness/' },
  { label: 'GitHub', href: 'https://github.com/jiselle03' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/jiselleliu' },
  { label: 'Writing', href: 'https://www.timidmag.com/writers/jiselle-liu' },
  { label: 'Email', href: 'mailto:hello@jiselleliu.com' },
];

const signals = [
  { label: 'Operational portals', value: 'Roles, approvals, queues, and audit-friendly work' },
  { label: 'AI-assisted workflows', value: 'Extraction, review, and recommendations with human oversight' },
  { label: 'Product systems', value: 'Clear flows, integrations, and the details that make work stick' },
];

const ownershipNotes = [
  { label: 'Workflow discovery', value: 'Find the friction, define the right system, and make the next step clear' },
  { label: 'Product delivery', value: 'Take a focused scope from working plan to production-quality software' },
];

const waysOfWorking = ['Fixed-scope builds', 'Pragmatic automation', 'Careful product surfaces'];

const preferredStack = ['TypeScript', 'Next.js', 'React', 'tRPC', 'Drizzle', 'PostgreSQL', 'Tailwind', 'OpenAI', 'Vitest'];
const additionalExperience = ['Vue', 'Ruby on Rails', 'Go', 'Express', 'MongoDB', 'React Query', 'Playwright', 'Claude Code', 'Codex'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Jiselle Liu builds workflow software that helps teams turn busywork into usable systems." />
    <meta name="theme-color" content="#0b1d2a" />
    <link rel="icon" type="image/svg+xml" href="/icons/jl-mark.svg" />
    <link rel="alternate icon" href="/icons/favicon_512.png" />
    <link rel="apple-touch-icon" href="/icons/favicon_512.png" />
    <link rel="manifest" href="/manifest.json" />
    <title>Jiselle Liu | Fullstack Engineer</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" aria-label="Site header">
      <a class="brand" href="/" aria-label="Jiselle Liu home">
        <span class="brand-mark" aria-hidden="true">JL</span>
        <span>Jiselle Liu</span>
      </a>

      <nav class="nav-links" aria-label="Primary navigation">
        {links.map((link) => (
          <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noreferrer' : undefined}>
            {link.label}
          </a>
        ))}
      </nav>
    </header>

    <main id="main" class="page-shell">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Fullstack engineer / workflow systems</p>
          <h1 id="hero-title">
            <span>Turn busywork</span>
            <span>into usable systems.</span>
          </h1>
          <p class="lede">
            I help teams understand where work gets stuck, define a better process, and ship
            the software or automation that makes it run.
          </p>

          <div class="hero-actions" aria-label="Primary links">
            <a class="button button-primary" href="mailto:hello@jiselleliu.com?subject=Project%20inquiry">Start a project</a>
            <a class="button button-secondary" href="/demo/vendor-readiness/">Try the demo</a>
          </div>
        </div>

        <div class="interface-board" aria-hidden="true">
          <div class="board-window window-a">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="board-window window-b">
            <span></span>
            <span></span>
          </div>
          <div class="board-cursor"></div>
        </div>
      </section>

      <section class="work-section" aria-labelledby="work-title">
        <div class="section-kicker">
          <h2 id="work-title">What I build</h2>
        </div>

        <div class="ownership-strip" aria-label="Work style">
          {ownershipNotes.map((item) => (
            <p>
              <span>{item.label}</span>
              {item.value}
            </p>
          ))}
        </div>

        <div class="signal-grid">
          {signals.map((item) => (
            <article class="signal-card">
              <p>{item.label}</p>
              <h3>{item.value}</h3>
            </article>
          ))}
        </div>

        <div class="earlier-work" aria-label="Ways of working">
          <p>How I work</p>
          <ul>
            {waysOfWorking.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </section>

      <section class="stack-band" aria-label="Technology stack">
        <div>
          <p>Preferred stack</p>
          <ul>
            {preferredStack.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>

        <div>
          <p>Additional experience</p>
          <ul>
            {additionalExperience.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </section>
    </main>
  </body>
</html>
